<!-- pages/index/index.wxml - 首页 -->
<view class="container">

  <!-- 顶部月份收支卡片 -->
  <view class="summary-card">
    <view class="summary-header">
      <text class="month-label">{{currentMonth}}</text>
      <text class="summary-subtitle">收支概览 🐾</text>
    </view>

    <view class="net-amount">
      <text class="net-label">结余</text>
      <text class="net-value {{monthNet >= 0 ? 'positive' : 'negative'}}">
        {{monthNet >= 0 ? '+' : ''}}{{monthNet}}
      </text>
    </view>

    <view class="summary-row">
      <view class="summary-item">
        <view class="summary-icon income-icon">💰</view>
        <view class="summary-detail">
          <text class="summary-type">收入</text>
          <text class="summary-amount income-amount">+{{monthIncome}}</text>
        </view>
      </view>
      <view class="summary-divider"></view>
      <view class="summary-item">
        <view class="summary-icon expense-icon">💸</view>
        <view class="summary-detail">
          <text class="summary-type">支出</text>
          <text class="summary-amount expense-amount">-{{monthExpense}}</text>
        </view>
      </view>
    </view>

    <!-- 今日速览行 -->
    <view class="today-row">
      <text class="today-label">今日</text>
      <view wx:if="{{hasTodayRecords}}" class="today-amounts">
        <text wx:if="{{todayExpense > 0}}" class="today-expense">支出 ¥{{todayExpense}}</text>
        <text wx:if="{{todayExpense > 0 && todayIncome > 0}}" class="today-sep">·</text>
        <text wx:if="{{todayIncome > 0}}" class="today-income">收入 ¥{{todayIncome}}</text>
        <text class="today-count">共 {{todayCount}} 笔</text>
      </view>
      <text wx:else class="today-empty">今天还没有记录 ~</text>
    </view>
  </view>

  <!-- 快速记账按钮 -->
  <view class="quick-add" bindtap="goToAdd">
    <text class="quick-add-icon">✏️</text>
    <text class="quick-add-text">记一笔</text>
  </view>

  <!-- 近6个月净储蓄折线卡片 -->
  <view class="card trend-line-card">
    <view class="trend-line-header">
      <view class="trend-line-title-row">
        <text class="trend-line-icon">📉</text>
        <text class="trend-line-title">近6个月净储蓄走势</text>
      </view>
      <view class="trend-line-net-tag {{monthNet >= 0 ? 'trend-line-tag-pos' : 'trend-line-tag-neg'}}">
        <text class="trend-line-tag-text">本月 {{monthNet >= 0 ? '+' : ''}}{{monthNet}}</text>
      </view>
    </view>

    <!-- Canvas 折线图（新版 API） -->
    <canvas
      type="2d"
      id="trendLineCanvas"
      class="trend-line-canvas"
    ></canvas>
    <!-- 旧版降级 -->
    <canvas
      canvas-id="trendLineCanvasLegacy"
      class="trend-line-canvas trend-line-canvas-legacy"
    ></canvas>

    <!-- 洞察文案 -->
    <view class="trend-line-insight">
      <text class="trend-line-insight-emoji">{{trendInsightEmoji}}</text>
      <text class="trend-line-insight-text">{{trendInsight}}</text>
    </view>
  </view>

  <!-- 月度预算卡片 -->
  <view class="card budget-card">
    <view class="budget-header">
      <view class="budget-title-row">
        <text class="budget-icon">🎯</text>
        <text class="budget-title">本月预算</text>
      </view>
      <view class="budget-set-btn" bindtap="onSetBudget">
        <text class="budget-set-text">{{hasBudget ? '修改' : '设置'}}</text>
      </view>
    </view>

    <!-- 未设置预算 -->
    <view wx:if="{{!hasBudget}}" class="budget-empty">
      <text class="budget-empty-text">还没有设置预算，点击右上角设置～</text>
    </view>

    <!-- 已设置预算 -->
    <view wx:else class="budget-content">
      <view class="budget-amounts">
        <view class="budget-used">
          <text class="budget-label-small">已支出</text>
          <text class="budget-val {{budgetOver ? 'budget-over-text' : 'budget-normal-text'}}">¥{{monthExpense}}</text>
        </view>
        <view class="budget-slash">/</view>
        <view class="budget-total">
          <text class="budget-label-small">预算</text>
          <text class="budget-val budget-total-text">¥{{budget}}</text>
        </view>
        <view class="budget-remain-wrap">
          <text wx:if="{{!budgetOver}}" class="budget-remain-ok">还剩 ¥{{budgetRemain}}</text>
          <text wx:else class="budget-remain-over">超出 ¥{{-budgetRemain}}</text>
        </view>
      </view>

      <!-- 进度条 -->
      <view class="budget-bar-bg">
        <view
          class="budget-bar-fill {{budgetOver ? 'budget-bar-over' : 'budget-bar-ok'}}"
          style="width: {{budgetPercent}}%;"
        ></view>
      </view>
      <view class="budget-percent-row">
        <text class="budget-percent-text {{budgetOver ? 'budget-over-text' : ''}}">已用 {{budgetPercent}}%</text>
      </view>
    </view>
  </view>

  <!-- 月度储蓄目标卡片 -->
  <view class="card saving-goal-card">
    <view class="saving-goal-header">
      <view class="saving-goal-title-row">
        <text class="saving-goal-icon">🐷</text>
        <text class="saving-goal-title">月度储蓄目标</text>
      </view>
      <view class="saving-goal-set-btn" bindtap="onSetSavingGoal">
        <text class="saving-goal-set-text">{{savingGoalProgress ? '修改' : '设置'}}</text>
      </view>
    </view>

    <!-- 未设置目标 -->
    <view wx:if="{{!savingGoalProgress}}" class="saving-goal-empty">
      <text class="saving-goal-empty-text">设置本月储蓄目标，追踪存钱进度 🐾</text>
    </view>

    <!-- 已设置目标 -->
    <view wx:else class="saving-goal-content">
      <!-- 金额行 -->
      <view class="saving-goal-amounts">
        <view class="saving-goal-actual-wrap">
          <text class="saving-goal-label">实际结余</text>
          <text class="saving-goal-actual {{savingGoalProgress.actual >= 0 ? 'saving-goal-actual-pos' : 'saving-goal-actual-neg'}}">
            {{savingGoalProgress.actual >= 0 ? '+' : ''}}¥{{savingGoalProgress.actual}}
          </text>
        </view>
        <view class="saving-goal-divider-v"></view>
        <view class="saving-goal-target-wrap">
          <text class="saving-goal-label">目标</text>
          <text class="saving-goal-target">¥{{savingGoalProgress.goal}}</text>
        </view>
        <view class="saving-goal-badge {{savingGoalProgress.isAchieved ? 'saving-goal-badge-done' : 'saving-goal-badge-pending'}}">
          <text class="saving-goal-badge-text">
            {{savingGoalProgress.isAchieved ? '已达标 ✓' : savingGoalProgress.percent + '%'}}
          </text>
        </view>
      </view>

      <!-- 进度条 -->
      <view class="saving-goal-bar-bg">
        <view
          class="saving-goal-bar-fill {{savingGoalProgress.isAchieved ? 'saving-goal-bar-done' : 'saving-goal-bar-ing'}}"
          style="width: {{savingGoalProgress.percent}}%;"
        ></view>
      </view>

      <!-- 提示文案 -->
      <view class="saving-goal-tip-row">
        <text class="saving-goal-tip-emoji">{{savingGoalProgress.tipEmoji}}</text>
        <text class="saving-goal-tip-text">{{savingGoalProgress.tipText}}</text>
      </view>
    </view>
  </view>

  <!-- 本月消费热力日历卡片 -->
  <view wx:if="{{heatmap}}" class="card heatmap-card">
    <view class="heatmap-header">
      <view class="heatmap-title-row">
        <text class="heatmap-icon">🗓️</text>
        <text class="heatmap-title">本月消费日历</text>
      </view>
      <view class="heatmap-legend">
        <text class="heatmap-legend-label">少</text>
        <view class="heatmap-cell heatmap-level-1"></view>
        <view class="heatmap-cell heatmap-level-2"></view>
        <view class="heatmap-cell heatmap-level-3"></view>
        <view class="heatmap-cell heatmap-level-4"></view>
        <text class="heatmap-legend-label">多</text>
      </view>
    </view>

    <!-- 星期标题行 -->
    <view class="heatmap-weekdays">
      <text class="heatmap-weekday">一</text>
      <text class="heatmap-weekday">二</text>
      <text class="heatmap-weekday">三</text>
      <text class="heatmap-weekday">四</text>
      <text class="heatmap-weekday">五</text>
      <text class="heatmap-weekday">六</text>
      <text class="heatmap-weekday">日</text>
    </view>

    <!-- 日历格子 -->
    <view class="heatmap-grid">
      <block wx:for="{{heatmap.weeks}}" wx:key="index" wx:for-item="week">
        <view class="heatmap-week-row">
          <block wx:for="{{week}}" wx:key="index" wx:for-item="cell">
            <view
              class="heatmap-cell-wrap {{cell.isEmpty ? 'heatmap-cell-empty' : ''}} {{cell.isToday ? 'heatmap-today-wrap' : ''}}"
            >
              <view
                wx:if="{{!cell.isEmpty}}"
                class="heatmap-day-cell heatmap-level-{{cell.isFuture ? 'future' : cell.level}} {{cell.isToday ? 'heatmap-today' : ''}}"
              >
                <text class="heatmap-day-num">{{cell.day}}</text>
              </view>
              <view wx:else class="heatmap-day-cell heatmap-level-empty"></view>
            </view>
          </block>
        </view>
      </block>
    </view>

    <!-- 底部汇总行 -->
    <view class="heatmap-footer">
      <text class="heatmap-footer-text">
        本月已有 <text class="heatmap-footer-accent">{{heatmap.totalDaysWithExpense}}</text> 天有支出记录
        <text wx:if="{{heatmap.maxAmount > 0}}">，单日最高 <text class="heatmap-footer-accent">¥{{heatmap.maxAmount}}</text></text>
      </text>
    </view>
  </view>

  <!-- 本周账单周报卡片 -->
  <view wx:if="{{weekSummary}}" class="card week-card">
    <view class="week-header">
      <view class="week-title-row">
        <text class="week-icon">📅</text>
        <text class="week-title">本周账单</text>
      </view>
      <view class="week-net-tag {{weekSummary.weekNet >= 0 ? 'week-tag-pos' : 'week-tag-neg'}}">
        <text class="week-tag-text">结余 {{weekSummary.weekNet >= 0 ? '+' : ''}}{{weekSummary.weekNet}}</text>
      </view>
    </view>

    <!-- 每日柱状图 -->
    <view class="week-bars">
      <block wx:for="{{weekSummary.days}}" wx:key="dateStr">
        <view class="week-bar-col {{item.isToday ? 'week-bar-today' : ''}}">
          <view class="week-bar-wrap">
            <view
              class="week-bar-fill {{item.isFuture ? 'week-bar-future' : (item.expense > 0 ? 'week-bar-active' : 'week-bar-zero')}}"
              style="height: {{item.isFuture ? 4 : (item.barHeight < 8 && item.expense > 0 ? 8 : item.barHeight)}}rpx;"
            ></view>
          </view>
          <text class="week-bar-label {{item.isToday ? 'week-bar-label-today' : ''}}">{{item.label}}</text>
          <text wx:if="{{item.expense > 0 && !item.isFuture}}" class="week-bar-amount">{{item.expense}}</text>
          <text wx:elif="{{item.isFuture}}" class="week-bar-amount week-bar-future-text">-</text>
          <text wx:else class="week-bar-amount week-bar-zero-text">0</text>
        </view>
      </block>
    </view>

    <!-- 周汇总行 -->
    <view class="week-summary-row">
      <view class="week-summary-item">
        <text class="week-summary-label">本周支出</text>
        <text class="week-summary-val week-expense-val">¥{{weekSummary.weekExpense}}</text>
      </view>
      <view class="week-summary-divider"></view>
      <view class="week-summary-item">
        <text class="week-summary-label">本周收入</text>
        <text class="week-summary-val week-income-val">¥{{weekSummary.weekIncome}}</text>
      </view>
      <view wx:if="{{weekSummary.topCategory}}" class="week-summary-divider"></view>
      <view wx:if="{{weekSummary.topCategory}}" class="week-summary-item">
        <text class="week-summary-label">消费最多</text>
        <text class="week-summary-val week-top-val">{{weekSummary.topCategory}}</text>
      </view>
    </view>
  </view>

  <!-- 财务健康评分卡片 -->
  <view wx:if="{{healthScore}}" class="card health-card">
    <view class="health-header">
      <view class="health-title-row">
        <text class="health-icon">💊</text>
        <text class="health-title">财务健康评分</text>
      </view>
      <view class="health-level-badge" style="background-color: {{healthScore.levelColor}}20; border-color: {{healthScore.levelColor}}40;">
        <text class="health-level-text" style="color: {{healthScore.levelColor}};">{{healthScore.levelEmoji}} {{healthScore.level}}</text>
      </view>
    </view>

    <!-- 分数 + 环形进度 -->
    <view class="health-score-row">
      <view class="health-score-circle-wrap">
        <!-- 用多层 view 模拟环形进度（纯 CSS） -->
        <view class="health-ring-bg">
          <view class="health-ring-fill" style="background: conic-gradient({{healthScore.levelColor}} {{healthScore.score * 3.6}}deg, #EEF7FB {{healthScore.score * 3.6}}deg);"></view>
          <view class="health-ring-inner">
            <text class="health-score-num" style="color: {{healthScore.levelColor}};">{{healthScore.score}}</text>
            <text class="health-score-unit">分</text>
          </view>
        </view>
      </view>

      <!-- 四维度小格 -->
      <view class="health-dims">
        <block wx:for="{{healthScore.dimensions}}" wx:key="label">
          <view class="health-dim-item">
            <text class="health-dim-icon">{{item.icon}}</text>
            <view class="health-dim-bar-bg">
              <view class="health-dim-bar-fill" style="width: {{Math.round(item.score / item.maxScore * 100)}}%; background-color: {{healthScore.levelColor}};"></view>
            </view>
            <text class="health-dim-label">{{item.label}}</text>
            <text class="health-dim-score">{{item.score}}/{{item.maxScore}}</text>
          </view>
        </block>
      </view>
    </view>

    <!-- 建议文案 -->
    <view class="health-tip-row">
      <text class="health-tip-icon">💡</text>
      <text class="health-tip-text">{{healthScore.tip}}</text>
    </view>
  </view>

  <!-- 打卡连击卡片 -->
  <view class="card streak-card">
    <view class="streak-header">
      <view class="streak-title-row">
        <text class="streak-icon">🔥</text>
        <text class="streak-title">记账打卡</text>
      </view>
      <text class="streak-badge {{todayDone ? 'streak-badge-done' : 'streak-badge-pending'}}">
        {{todayDone ? '今日已打卡 ✓' : '今日未打卡'}}
      </text>
    </view>

    <view class="streak-body">
      <!-- 当前连击 -->
      <view class="streak-main">
        <text class="streak-number">{{streak}}</text>
        <view class="streak-meta">
          <text class="streak-days-label">连续记账天</text>
          <text class="streak-sub-title">{{streakTitle}}</text>
        </view>
      </view>
      <!-- 分隔线 -->
      <view class="streak-divider"></view>
      <!-- 历史最长 -->
      <view class="streak-longest">
        <text class="streak-longest-num">{{longestStreak}}</text>
        <text class="streak-longest-label">历史最长</text>
      </view>
    </view>

    <!-- 打卡提示语 -->
    <text wx:if="{{!todayDone}}" class="streak-hint">今天还没记账，去 ✏️ 记一笔吧～</text>
    <text wx:else class="streak-hint streak-hint-done">今天已记账，继续保持！加油 🌸</text>
  </view>

  <!-- 最近账单 -->
  <view class="card recent-section">
    <view class="flex-between section-header">
      <text class="section-title">最近账单</text>
      <view bindtap="goToList">
        <text class="view-all">全部 →</text>
      </view>
    </view>

    <!-- 空状态 -->
    <view wx:if="{{isEmpty}}" class="empty-state">
      <text class="empty-emoji">🌸</text>
      <text class="empty-text">还没有账单，快来记一笔吧～</text>
    </view>

    <!-- 账单列表 -->
    <view wx:else>
      <block wx:for="{{recentGroups}}" wx:key="date">
        <view class="date-group">
          <text class="date-label">{{item.dateLabel}}</text>
          <view
            class="record-item"
            wx:for="{{item.records}}"
            wx:for-item="record"
            wx:key="id"
          >
            <view class="record-left">
              <view class="record-category-icon">
                <text>{{record.emoji}}</text>
              </view>
              <view class="record-info">
                <text class="record-category">{{record.category}}</text>
                <text class="record-note" wx:if="{{record.note}}">{{record.note}}</text>
              </view>
            </view>
            <text class="record-amount {{record.type === 'income' ? 'amount-income' : 'amount-expense'}}">
              {{record.amountDisplay}}
            </text>
          </view>
        </view>
      </block>
    </view>
  </view>

</view>
