/* pages/index/index.wxss */

/* 月度汇总卡片 */
.summary-card {
  background: linear-gradient(145deg, #7EC8E3, #4FB8D4);
  border-radius: 32rpx;
  padding: 40rpx 36rpx;
  margin-bottom: 24rpx;
  color: #FFFFFF;
  box-shadow: 0 8rpx 32rpx rgba(79, 184, 212, 0.35);
}

.summary-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 28rpx;
}

.month-label {
  font-size: 34rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.summary-subtitle {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
}

.net-amount {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 32rpx;
}

.net-label {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-bottom: 8rpx;
}

.net-value {
  font-size: 72rpx;
  font-weight: 700;
  color: #FFFFFF;
  line-height: 1.1;
}

.net-value.negative {
  color: #FFE0E8;
}

.summary-row {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.18);
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
}

.summary-item {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.summary-icon {
  font-size: 44rpx;
  width: 56rpx;
  text-align: center;
}

.summary-detail {
  display: flex;
  flex-direction: column;
}

.summary-type {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-bottom: 4rpx;
}

.summary-amount {
  font-size: 34rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.summary-divider {
  width: 1rpx;
  height: 56rpx;
  background: rgba(255, 255, 255, 0.3);
  margin: 0 24rpx;
}

/* 快速记账 */
.quick-add {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  background: #FFFFFF;
  border-radius: 100rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(79, 184, 212, 0.15);
  border: 2rpx solid #E8F4F8;
  cursor: pointer;
}

.quick-add:active {
  opacity: 0.85;
  transform: scale(0.99);
}

.quick-add-icon {
  font-size: 36rpx;
}

.quick-add-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #4FB8D4;
}

/* 最近账单区域 */
.recent-section {
  padding: 28rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #3D5A6E;
}

.view-all {
  font-size: 26rpx;
  color: #4FB8D4;
}

/* 日期分组 */
.date-group {
  margin-bottom: 16rpx;
}

.date-label {
  font-size: 24rpx;
  color: #9BAAB8;
  padding: 8rpx 0;
  display: block;
}

/* 账单条目 */
.record-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F0F8FF;
}

.record-item:last-child {
  border-bottom: none;
}

.record-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.record-category-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #EEF8FB;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
}

.record-info {
  display: flex;
  flex-direction: column;
}

.record-category {
  font-size: 30rpx;
  font-weight: 500;
  color: #3D5A6E;
}

.record-note {
  font-size: 24rpx;
  color: #9BAAB8;
  margin-top: 4rpx;
}

.record-amount {
  font-size: 32rpx;
  font-weight: 600;
}

.amount-income {
  color: #4FB8D4;
}

.amount-expense {
  color: #FF8BAB;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0;
}

.empty-emoji {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #9BAAB8;
}

/* ─── 近6个月净储蓄折线卡片 ─── */
.trend-line-card {
  padding: 28rpx 32rpx 24rpx;
  margin-bottom: 24rpx;
}

.trend-line-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.trend-line-title-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.trend-line-icon {
  font-size: 34rpx;
}

.trend-line-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #3D5A6E;
}

.trend-line-net-tag {
  border-radius: 100rpx;
  padding: 6rpx 22rpx;
}

.trend-line-tag-pos {
  background: #EEF8FB;
}

.trend-line-tag-neg {
  background: #FFF0F4;
}

.trend-line-tag-text {
  font-size: 24rpx;
  font-weight: 600;
}

.trend-line-tag-pos .trend-line-tag-text {
  color: #4FB8D4;
}

.trend-line-tag-neg .trend-line-tag-text {
  color: #FF8BAB;
}

.trend-line-canvas {
  width: 100%;
  height: 140rpx;
  display: block;
}

/* 旧版 canvas 隐藏（仅作降级备用，实际显示由 JS 控制） */
.trend-line-canvas-legacy {
  display: none;
}

.trend-line-insight {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 18rpx;
  background: #F5FBFD;
  border-radius: 16rpx;
  padding: 14rpx 20rpx;
}

.trend-line-insight-emoji {
  font-size: 28rpx;
  flex-shrink: 0;
}

.trend-line-insight-text {
  font-size: 24rpx;
  color: #5A7A8A;
  flex: 1;
  line-height: 1.5;
}

/* ─── 月度预算卡片 ─── */
.budget-card {
  padding: 28rpx 32rpx;
  margin-bottom: 24rpx;
}

.budget-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.budget-title-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.budget-icon {
  font-size: 36rpx;
}

.budget-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #3D5A6E;
}

.budget-set-btn {
  background: #EEF8FB;
  border-radius: 100rpx;
  padding: 8rpx 28rpx;
}

.budget-set-text {
  font-size: 26rpx;
  color: #4FB8D4;
  font-weight: 500;
}

/* 未设置预算 */
.budget-empty {
  padding: 16rpx 0 8rpx;
}

.budget-empty-text {
  font-size: 26rpx;
  color: #B8CCD8;
}

/* 已设置预算 */
.budget-content {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.budget-amounts {
  display: flex;
  align-items: flex-end;
  gap: 16rpx;
}

.budget-used,
.budget-total {
  display: flex;
  flex-direction: column;
}

.budget-label-small {
  font-size: 22rpx;
  color: #9BAAB8;
  margin-bottom: 4rpx;
}

.budget-val {
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.1;
}

.budget-normal-text {
  color: #3D5A6E;
}

.budget-over-text {
  color: #FF8BAB;
}

.budget-total-text {
  color: #9BAAB8;
}

.budget-slash {
  font-size: 36rpx;
  color: #C8D8E4;
  padding-bottom: 4rpx;
}

.budget-remain-wrap {
  margin-left: auto;
  display: flex;
  align-items: center;
}

.budget-remain-ok {
  font-size: 26rpx;
  color: #4FB8D4;
  background: #EEF8FB;
  border-radius: 100rpx;
  padding: 6rpx 20rpx;
}

.budget-remain-over {
  font-size: 26rpx;
  color: #FF8BAB;
  background: #FFF0F4;
  border-radius: 100rpx;
  padding: 6rpx 20rpx;
}

/* 进度条 */
.budget-bar-bg {
  width: 100%;
  height: 16rpx;
  background: #EEF8FB;
  border-radius: 100rpx;
  overflow: hidden;
}

.budget-bar-fill {
  height: 100%;
  border-radius: 100rpx;
  transition: width 0.4s ease;
}

.budget-bar-ok {
  background: linear-gradient(90deg, #7EC8E3, #4FB8D4);
}

.budget-bar-over {
  background: linear-gradient(90deg, #FFB3C6, #FF8BAB);
}

.budget-percent-row {
  display: flex;
  justify-content: flex-end;
}

.budget-percent-text {
  font-size: 22rpx;
  color: #9BAAB8;
}

/* ─── 打卡连击卡片 ────────────────────────────────────── */
.streak-card {
  margin-bottom: 24rpx;
}

.streak-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.streak-title-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.streak-icon {
  font-size: 36rpx;
}

.streak-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #3D5A6E;
}

.streak-badge {
  font-size: 22rpx;
  border-radius: 100rpx;
  padding: 6rpx 20rpx;
}

.streak-badge-done {
  background: #EEF8FB;
  color: #4FB8D4;
}

.streak-badge-pending {
  background: #FFF5F0;
  color: #FFAA88;
}

.streak-body {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.streak-main {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex: 1;
}

.streak-number {
  font-size: 80rpx;
  font-weight: 800;
  color: #FF8BAB;
  line-height: 1;
}

.streak-meta {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.streak-days-label {
  font-size: 24rpx;
  color: #9BAAB8;
}

.streak-sub-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #3D5A6E;
}

.streak-divider {
  width: 2rpx;
  height: 80rpx;
  background: #EEF8FB;
  margin: 0 32rpx;
}

.streak-longest {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  min-width: 100rpx;
}

.streak-longest-num {
  font-size: 48rpx;
  font-weight: 800;
  color: #4FB8D4;
  line-height: 1;
}

.streak-longest-label {
  font-size: 22rpx;
  color: #9BAAB8;
}

.streak-hint {
  display: block;
  font-size: 24rpx;
  color: #FFAA88;
  background: #FFF5F0;
  border-radius: 16rpx;
  padding: 14rpx 20rpx;
  text-align: center;
}

.streak-hint-done {
  color: #4FB8D4;
  background: #EEF8FB;
}

/* 今日速览行 */
.today-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 20rpx;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 16rpx;
  padding: 14rpx 20rpx;
}

.today-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
  white-space: nowrap;
}

.today-amounts {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
  flex: 1;
}

.today-expense {
  font-size: 24rpx;
  color: #FFD6DF;
  font-weight: 600;
}

.today-income {
  font-size: 24rpx;
  color: #CCEFF9;
  font-weight: 600;
}

.today-sep {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.5);
}

.today-count {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.6);
  margin-left: 4rpx;
}

.today-empty {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.55);
  flex: 1;
}

/* ─── 本月消费热力日历卡片 ─────────────────────────────── */
.heatmap-card {
  padding: 28rpx 32rpx 24rpx;
  margin-bottom: 24rpx;
}

.heatmap-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.heatmap-title-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.heatmap-icon {
  font-size: 36rpx;
}

.heatmap-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #3D5A6E;
}

/* 图例 */
.heatmap-legend {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.heatmap-legend-label {
  font-size: 20rpx;
  color: #B0C4D0;
}

/* 星期标题行 */
.heatmap-weekdays {
  display: flex;
  margin-bottom: 8rpx;
}

.heatmap-weekday {
  flex: 1;
  text-align: center;
  font-size: 20rpx;
  color: #9BAAB8;
  font-weight: 500;
}

/* 格子网格 */
.heatmap-grid {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.heatmap-week-row {
  display: flex;
  gap: 6rpx;
}

.heatmap-cell-wrap {
  flex: 1;
  display: flex;
  justify-content: center;
  align-items: center;
  aspect-ratio: 1;
}

.heatmap-cell-empty {
  /* 占位格，不可见 */
}

.heatmap-today-wrap {
  /* 今日外圈高亮 */
}

/* 日期格子（正方形，带圆角） */
.heatmap-day-cell {
  width: 100%;
  aspect-ratio: 1;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.heatmap-day-num {
  font-size: 18rpx;
  line-height: 1;
}

/* 热力等级颜色 */
.heatmap-level-empty,
.heatmap-level-0 {
  background: #EEF8FB;
}

.heatmap-level-empty .heatmap-day-num,
.heatmap-level-0 .heatmap-day-num {
  color: transparent;
}

.heatmap-level-0 .heatmap-day-num {
  color: #B0C8D4;
}

.heatmap-level-1 {
  background: #C8E8F4;
}

.heatmap-level-1 .heatmap-day-num {
  color: #7AAFC4;
}

.heatmap-level-2 {
  background: #7EC8E3;
}

.heatmap-level-2 .heatmap-day-num {
  color: #3D7A8A;
}

.heatmap-level-3 {
  background: #4FB8D4;
}

.heatmap-level-3 .heatmap-day-num {
  color: #FFFFFF;
}

.heatmap-level-4 {
  background: #FF8BAB;
}

.heatmap-level-4 .heatmap-day-num {
  color: #FFFFFF;
}

/* 未来日期 */
.heatmap-level-future {
  background: #F5F9FB;
}

.heatmap-level-future .heatmap-day-num {
  color: #C8D8E4;
}

/* 今日高亮：外圈圆角边框 */
.heatmap-today {
  border: 2rpx solid #FF8BAB;
  box-sizing: border-box;
}

/* 图例中的小方块（复用 heatmap-cell） */
.heatmap-cell {
  width: 22rpx;
  height: 22rpx;
  border-radius: 5rpx;
}

/* 底部汇总行 */
.heatmap-footer {
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #EEF8FB;
}

.heatmap-footer-text {
  font-size: 24rpx;
  color: #9BAAB8;
}

.heatmap-footer-accent {
  color: #4FB8D4;
  font-weight: 600;
}

/* ─── 本周账单周报卡片 ───────────────────────────────── */
.week-card {
  padding: 28rpx 28rpx 22rpx;
}

.week-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.week-title-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.week-icon {
  font-size: 34rpx;
}

.week-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #2D4A6B;
}

.week-net-tag {
  padding: 6rpx 18rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.week-tag-pos {
  background: #E8F8F0;
  color: #3DAA72;
}

.week-tag-neg {
  background: #FFF0F4;
  color: #FF8BAB;
}

.week-tag-text {
  font-size: 24rpx;
  font-weight: 600;
}

/* 柱状图区域 */
.week-bars {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  height: 160rpx;
  margin-bottom: 20rpx;
  padding: 0 8rpx;
}

.week-bar-col {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
  gap: 6rpx;
}

.week-bar-wrap {
  width: 100%;
  height: 100rpx;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.week-bar-fill {
  width: 38rpx;
  border-radius: 8rpx 8rpx 4rpx 4rpx;
  min-height: 4rpx;
  transition: height 0.3s ease;
}

.week-bar-active {
  background: linear-gradient(180deg, #7EC8E3 0%, #4FB8D4 100%);
}

.week-bar-zero {
  background: #EEF8FB;
  min-height: 4rpx;
  height: 4rpx !important;
}

.week-bar-future {
  background: #F0F5F8;
  height: 4rpx !important;
}

/* 今天高亮 */
.week-bar-today .week-bar-fill.week-bar-active {
  background: linear-gradient(180deg, #FFB3C6 0%, #FF8BAB 100%);
}

.week-bar-label {
  font-size: 22rpx;
  color: #9BAAB8;
  font-weight: 500;
}

.week-bar-label-today {
  color: #FF8BAB;
  font-weight: 700;
}

.week-bar-amount {
  font-size: 18rpx;
  color: #6B8AAA;
}

.week-bar-future-text {
  color: #C8D8E4;
}

.week-bar-zero-text {
  color: #C8D8E4;
}

/* 汇总行 */
.week-summary-row {
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding-top: 20rpx;
  border-top: 1rpx solid #EEF8FB;
}

.week-summary-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  flex: 1;
}

.week-summary-divider {
  width: 1rpx;
  height: 40rpx;
  background: #EEF8FB;
}

.week-summary-label {
  font-size: 22rpx;
  color: #9BAAB8;
}

.week-summary-val {
  font-size: 28rpx;
  font-weight: 700;
}

.week-expense-val {
  color: #FF8BAB;
}

.week-income-val {
  color: #4FB8D4;
}

.week-top-val {
  color: #2D4A6B;
  font-size: 26rpx;
}

/* ─── 月度储蓄目标卡片 ─────────────────────────────── */
.saving-goal-card {
  padding: 28rpx 32rpx;
  margin-bottom: 24rpx;
}

.saving-goal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.saving-goal-title-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.saving-goal-icon {
  font-size: 36rpx;
}

.saving-goal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #3D5A6E;
}

.saving-goal-set-btn {
  background: #EEF8FB;
  border-radius: 100rpx;
  padding: 8rpx 28rpx;
}

.saving-goal-set-text {
  font-size: 26rpx;
  color: #4FB8D4;
  font-weight: 500;
}

/* 未设置目标 */
.saving-goal-empty {
  padding: 12rpx 0 8rpx;
}

.saving-goal-empty-text {
  font-size: 26rpx;
  color: #B8CCD8;
}

/* 已设置目标内容 */
.saving-goal-content {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

/* 金额行 */
.saving-goal-amounts {
  display: flex;
  align-items: flex-end;
  gap: 20rpx;
}

.saving-goal-actual-wrap,
.saving-goal-target-wrap {
  display: flex;
  flex-direction: column;
}

.saving-goal-label {
  font-size: 22rpx;
  color: #9BAAB8;
  margin-bottom: 4rpx;
}

.saving-goal-actual {
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.1;
}

.saving-goal-actual-pos {
  color: #3DAA72;
}

.saving-goal-actual-neg {
  color: #FF8BAB;
}

.saving-goal-target {
  font-size: 36rpx;
  font-weight: 600;
  color: #9BAAB8;
  line-height: 1.1;
}

.saving-goal-divider-v {
  width: 1rpx;
  height: 56rpx;
  background: #E8F4F8;
  margin-bottom: 4rpx;
}

.saving-goal-badge {
  margin-left: auto;
  border-radius: 100rpx;
  padding: 8rpx 24rpx;
  display: flex;
  align-items: center;
}

.saving-goal-badge-done {
  background: #E8F8EF;
}

.saving-goal-badge-pending {
  background: #EEF8FB;
}

.saving-goal-badge-text {
  font-size: 26rpx;
  font-weight: 700;
}

.saving-goal-badge-done .saving-goal-badge-text {
  color: #3DAA72;
}

.saving-goal-badge-pending .saving-goal-badge-text {
  color: #4FB8D4;
}

/* 进度条 */
.saving-goal-bar-bg {
  width: 100%;
  height: 18rpx;
  background: #EEF8FB;
  border-radius: 100rpx;
  overflow: hidden;
}

.saving-goal-bar-fill {
  height: 100%;
  border-radius: 100rpx;
  transition: width 0.5s ease;
  min-width: 0;
}

.saving-goal-bar-ing {
  background: linear-gradient(90deg, #7EC8E3, #4FB8D4);
}

.saving-goal-bar-done {
  background: linear-gradient(90deg, #6EDFA0, #3DAA72);
}

/* 提示文案 */
.saving-goal-tip-row {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  background: #F5FBFD;
  border-radius: 16rpx;
  padding: 14rpx 20rpx;
}

.saving-goal-tip-emoji {
  font-size: 28rpx;
  flex-shrink: 0;
}

.saving-goal-tip-text {
  font-size: 24rpx;
  color: #5A7A8A;
  flex: 1;
  line-height: 1.6;
}

/* ─── 财务健康评分卡片 ─────────────────────────────── */
.health-card {
  padding: 32rpx 28rpx 28rpx;
}

.health-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28rpx;
}

.health-title-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.health-icon {
  font-size: 32rpx;
}

.health-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #2D4A6B;
}

.health-level-badge {
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
  border: 1rpx solid;
}

.health-level-text {
  font-size: 24rpx;
  font-weight: 600;
}

/* 分数行 */
.health-score-row {
  display: flex;
  align-items: center;
  gap: 28rpx;
  margin-bottom: 24rpx;
}

/* 环形进度（CSS conic-gradient） */
.health-score-circle-wrap {
  flex-shrink: 0;
}

.health-ring-bg {
  position: relative;
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
}

.health-ring-fill {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
}

.health-ring-inner {
  position: absolute;
  top: 14rpx;
  left: 14rpx;
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: #FFFFFF;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.health-score-num {
  font-size: 44rpx;
  font-weight: 800;
  line-height: 1;
}

.health-score-unit {
  font-size: 20rpx;
  color: #9BAAB8;
  margin-top: 2rpx;
}

/* 四维度 */
.health-dims {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.health-dim-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.health-dim-icon {
  font-size: 24rpx;
  width: 32rpx;
  text-align: center;
}

.health-dim-bar-bg {
  flex: 1;
  height: 10rpx;
  background: #EEF7FB;
  border-radius: 10rpx;
  overflow: hidden;
}

.health-dim-bar-fill {
  height: 100%;
  border-radius: 10rpx;
  transition: width 0.4s ease;
}

.health-dim-label {
  font-size: 20rpx;
  color: #9BAAB8;
  width: 76rpx;
  text-align: right;
}

.health-dim-score {
  font-size: 20rpx;
  color: #B8C8D8;
  width: 64rpx;
  text-align: right;
}

/* 建议文案行 */
.health-tip-row {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  background: #F5FBFD;
  border-radius: 16rpx;
  padding: 18rpx 20rpx;
}

.health-tip-icon {
  font-size: 26rpx;
  flex-shrink: 0;
}

.health-tip-text {
  font-size: 24rpx;
  color: #5A7A8A;
  line-height: 1.6;
  flex: 1;
}

/* ────────── 周期性固定账单卡片 ────────── */

.recurring-card {
  padding: 28rpx 30rpx 20rpx;
}

.recurring-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.recurring-title-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.recurring-icon {
  font-size: 32rpx;
}

.recurring-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #2C4B5E;
}

.recurring-manage-btn {
  padding: 6rpx 20rpx;
  background: #EFF8FC;
  border-radius: 20rpx;
}

.recurring-manage-text {
  font-size: 22rpx;
  color: #4FB8D4;
}

.recurring-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.recurring-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #F5FBFD;
  border-radius: 18rpx;
  padding: 18rpx 20rpx;
}

.recurring-item-left {
  display: flex;
  align-items: center;
  gap: 14rpx;
  flex: 1;
}

.recurring-emoji {
  font-size: 34rpx;
  width: 44rpx;
  text-align: center;
}

.recurring-item-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.recurring-item-name {
  font-size: 26rpx;
  font-weight: 500;
  color: #2C4B5E;
}

.recurring-item-status {
  font-size: 20rpx;
}

.recurring-status-overdue {
  color: #FF6B8A;
  font-weight: 500;
}

.recurring-status-today {
  color: #FF9A3C;
  font-weight: 500;
}

.recurring-status-soon {
  color: #FFAA44;
}

.recurring-status-normal {
  color: #8BA4B0;
}

.recurring-item-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.recurring-item-amount {
  font-size: 28rpx;
  font-weight: 600;
  color: #FF8BAB;
}

.recurring-item-btn {
  font-size: 22rpx;
  color: #fff;
  background: #4FB8D4;
  border-radius: 20rpx;
  padding: 6rpx 18rpx;
}

/* 空状态入口卡片 */
.recurring-empty-card {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 28rpx;
  background: #F5FBFD;
