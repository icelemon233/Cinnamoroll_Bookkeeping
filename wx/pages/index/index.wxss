}

.recurring-manage-list {
  max-height: 600rpx;
  margin: 12rpx 0 0;
}

.recurring-manage-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #F0F6F9;
}

.recurring-manage-left {
  display: flex;
  align-items: center;
  gap: 14rpx;
  flex: 1;
}

.recurring-manage-emoji {
  font-size: 32rpx;
}

.recurring-manage-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.recurring-manage-name {
  font-size: 26rpx;
  font-weight: 500;
  color: #2C4B5E;
}

.recurring-manage-meta {
  font-size: 20rpx;
  color: #8BA4B0;
}

.recurring-manage-actions {
  display: flex;
