  flex: 1;
}

.recurring-empty-add {
  font-size: 24rpx;
  color: #4FB8D4;
  font-weight: 500;
}

/* ────────── 固定账单弹窗 ────────── */

.recurring-manage-modal,
.recurring-add-modal {
  width: 90%;
  max-width: 660rpx;
  padding: 36rpx 32rpx 28rpx;
  border-radius: 28rpx;
  background: #fff;
}

.recurring-modal-empty {
  text-align: center;
  color: #aaa;
  font-size: 26rpx;
