<!-- pages/add/add.wxml - 记账页（支持新增/编辑两种模式） -->
<view class="container">

  <!-- 快捷记账模板（非编辑模式下显示） -->
  <view wx:if="{{!isEditMode && hasTemplates}}" class="templates-section">
    <view class="templates-header">
      <view class="templates-header-left">
        <text class="templates-icon">⚡</text>
        <text class="templates-label">快捷模板</text>
      </view>
      <text class="templates-hint">长按可删除</text>
    </view>
    <scroll-view scroll-x class="templates-scroll" enhanced="{{true}}" show-scrollbar="{{false}}">
      <view class="templates-row">
        <view
          class="template-chip"
          wx:for="{{templates}}"
          wx:key="id"
          data-id="{{item.id}}"
          data-name="{{item.name}}"
          data-amount="{{item.amount}}"
          bindtap="tapTemplate"
          bindlongpress="longPressTemplate"
        >
          <text class="template-chip-name">{{item.name || item.category}}</text>
          <text class="template-chip-amount {{item.type === 'income' ? 'income-text' : 'expense-text'}}">{{item.type === 'income' ? '+' : '-'}}¥{{item.amount}}</text>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 今日速览横幅（非编辑模式下显示） -->
  <view wx:if="{{!isEditMode}}" class="today-banner">
    <view class="today-banner-inner">
      <view class="today-banner-left">
        <text class="today-banner-icon">☀️</text>
        <text class="today-banner-label">今日已花</text>
      </view>
      <view class="today-banner-right">
        <text class="today-banner-expense">¥{{todayExpense}}</text>
        <text wx:if="{{hasTodayRecords}}" class="today-banner-count">共 {{todayCount}} 笔</text>
        <text wx:else class="today-banner-count">还没有支出 ✨</text>
      </view>
    </view>
    <view wx:if="{{todayIncome > 0}}" class="today-banner-income-row">
      <text class="today-banner-income-label">今日收入</text>
      <text class="today-banner-income-val">+¥{{todayIncome}}</text>
    </view>
  </view>

  <!-- 收入/支出切换（编辑模式下仍可切换） -->
  <view class="type-switcher">
    <view
      class="type-btn {{type === 'expense' ? 'type-btn-active-expense' : ''}}"
      data-type="expense"
      bindtap="switchType"
    >
      <text>💸 支出</text>
    </view>
    <view
      class="type-btn {{type === 'income' ? 'type-btn-active-income' : ''}}"
      data-type="income"
      bindtap="switchType"
    >
      <text>💰 收入</text>
    </view>
  </view>

  <!-- 金额显示 -->
  <view class="amount-display-card">
    <text class="amount-unit">¥</text>
    <view class="amount-display-inner">
      <text class="amount-display {{type === 'income' ? 'income-text' : 'expense-text'}}">
        {{amountStr || '0.00'}}
      </text>
      <!-- 表达式有运算符时，下方显示实时求值结果 -->
      <view wx:if="{{hasOperator && amountResult}}" class="amount-result-row">
        <text class="amount-result-eq">=</text>
        <text class="amount-result {{type === 'income' ? 'income-text' : 'expense-text'}}">
          {{amountResult}}
        </text>
      </view>
    </view>
    <!-- AA 分摊按钒：有金额时显示 -->
    <view
      wx:if="{{amountStr && amountStr !== '0'}}"
      class="aa-split-btn"
      bindtap="openSplitModal"
    >
      <text class="aa-split-icon">👥</text>
      <text class="aa-split-text">AA</text>
    </view>
  </view>

  <!-- 分类选择 -->
  <view class="card category-section">
    <text class="form-label">分类</text>
    <view class="category-grid">
      <view
        class="category-item {{selectedCategory === item.name ? 'category-selected' : ''}}"
        wx:for="{{categories}}"
        wx:key="name"
        data-category="{{item.name}}"
        bindtap="selectCategory"
        bindlongpress="longPressCategory"
      >
        <text class="category-emoji">{{item.emoji}}</text>
        <text class="category-name">{{item.name}}</text>
      </view>
    </view>
  </view>

  <!-- 备注和日期 -->
  <view class="card form-section">
    <view class="form-row">
      <text class="form-label-inline">📅 日期</text>
      <view class="date-quick-row">
        <view
          class="date-quick-btn {{date === todayStr ? 'date-quick-active' : ''}}"
          data-offset="0"
          bindtap="onQuickDate"
        ><text>今天</text></view>
        <view
          class="date-quick-btn {{date === yesterdayStr ? 'date-quick-active' : ''}}"
          data-offset="1"
          bindtap="onQuickDate"
        ><text>昨天</text></view>
        <view
          class="date-quick-btn {{date === dayBeforeStr ? 'date-quick-active' : ''}}"
          data-offset="2"
          bindtap="onQuickDate"
        ><text>前天</text></view>
        <picker mode="date" value="{{date}}" bindchange="onDateChange">
          <view class="date-quick-btn date-quick-picker {{(date !== todayStr && date !== yesterdayStr && date !== dayBeforeStr) ? 'date-quick-active' : ''}}">
            <text>{{(date !== todayStr && date !== yesterdayStr && date !== dayBeforeStr) ? date : '其他'}}</text>
          </view>
        </picker>
      </view>
    </view>
    <view class="divider-light"></view>
    <view class="form-row note-input-row">
      <text class="form-label-inline">📝 备注</text>
      <input
        class="form-input"
        value="{{note}}"
        placeholder="点击添加备注..."
        placeholder-class="input-placeholder"
        bindinput="onNoteInput"
        maxlength="30"
      />
    </view>
    <!-- 备注智能联想下拉 -->
    <view wx:if="{{showNoteSuggestions}}" class="note-suggestions-wrap">
      <view
        class="note-suggestion-item"
        wx:for="{{noteSuggestions}}"
        wx:key="*this"
        data-suggestion="{{item}}"
        bindtap="tapNoteSuggestion"
      >
        <text class="note-suggestion-icon">🕐</text>
        <text class="note-suggestion-text">{{item}}</text>
      </view>
    </view>
    <!-- 常用备注快捷标签 -->
    <view wx:if="{{quickNotes.length > 0}}" class="quick-notes-row">
      <scroll-view scroll-x class="quick-notes-scroll">
        <view class="quick-notes-inner">
          <view
            class="quick-note-tag {{note === item ? 'quick-note-tag-active' : ''}}"
            wx:for="{{quickNotes}}"
            wx:key="*this"
            data-tag="{{item}}"
            bindtap="tapQuickNote"
          >
            <text>{{item}}</text>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>

  <!-- 最近相似记录（同分类同类型，一键复用金额+备注，非编辑模式显示） -->
  <view wx:if="{{!isEditMode && hasRecentRecords}}" class="recent-records-section">
    <view class="recent-records-header">
      <text class="recent-records-label">🕐 最近 {{selectedCategory}} 记录</text>
      <text class="recent-records-hint">点击快速填入</text>
    </view>
    <scroll-view scroll-x class="recent-records-scroll" enhanced="{{true}}" show-scrollbar="{{false}}">
      <view class="recent-records-row">
        <view
          class="recent-record-chip"
          wx:for="{{recentRecords}}"
          wx:key="index"
          data-amount="{{item.amount}}"
          data-note="{{item.note}}"
          bindtap="tapRecentRecord"
        >
          <text class="recent-chip-amount {{type === 'income' ? 'income-text' : 'expense-text'}}">¥{{item.amount}}</text>
          <text wx:if="{{item.note}}" class="recent-chip-note">{{item.note}}</text>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 常用金额快捷（基于历史记账频率自动生成，有数据时显示） -->
  <view wx:if="{{hasTopAmounts}}" class="top-amounts-section">
    <view class="top-amounts-header">
      <text class="top-amounts-label">⚡ 常用金额</text>
    </view>
    <scroll-view scroll-x class="top-amounts-scroll" enhanced="{{true}}" show-scrollbar="{{false}}">
      <view class="top-amounts-row">
        <view
          class="top-amount-chip {{amountStr === String(item) ? 'top-amount-chip-active' : ''}}"
          wx:for="{{topAmounts}}"
          wx:key="*this"
          data-amount="{{item}}"
          bindtap="tapTopAmount"
        >
          <text class="top-amount-text {{type === 'income' ? 'income-text' : ''}}">¥{{item}}</text>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 存为模板快捷入口（非编辑模式，已填写金额时显示） -->
  <view wx:if="{{!isEditMode && amountStr && amountStr !== '0'}}" class="save-template-row">
    <view class="save-template-btn" bindtap="saveAsTemplate">
      <text class="save-template-icon">📌</text>
      <text class="save-template-text">存为模板</text>
    </view>
  </view>

  <!-- 数字键盘（支持加减运算符，可连续计算总金额） -->
  <view class="keyboard">
    <view class="keyboard-row">
      <view class="key-btn" data-key="7" bindtap="pressKey"><text>7</text></view>
      <view class="key-btn" data-key="8" bindtap="pressKey"><text>8</text></view>
      <view class="key-btn" data-key="9" bindtap="pressKey"><text>9</text></view>
      <view class="key-btn key-del" data-key="del" bindtap="pressKey"><text>⌫</text></view>
    </view>
    <view class="keyboard-row">
      <view class="key-btn" data-key="4" bindtap="pressKey"><text>4</text></view>
      <view class="key-btn" data-key="5" bindtap="pressKey"><text>5</text></view>
      <view class="key-btn" data-key="6" bindtap="pressKey"><text>6</text></view>
      <view class="key-btn key-operator" data-key="+" bindtap="pressKey"><text>+</text></view>
    </view>
    <view class="keyboard-row">
      <view class="key-btn" data-key="1" bindtap="pressKey"><text>1</text></view>
      <view class="key-btn" data-key="2" bindtap="pressKey"><text>2</text></view>
      <view class="key-btn" data-key="3" bindtap="pressKey"><text>3</text></view>
      <view class="key-btn key-operator" data-key="-" bindtap="pressKey"><text>−</text></view>
    </view>
    <view class="keyboard-row">
      <view class="key-btn key-dot" data-key="." bindtap="pressKey"><text>.</text></view>
      <view class="key-btn" data-key="0" bindtap="pressKey"><text>0</text></view>
      <view
        class="key-btn key-save {{type === 'income' ? 'key-save-income' : 'key-save-expense'}}"
        bindtap="saveRecord"
        style="flex: 2"
      >
        <text>{{isEditMode ? '保存修改 ✨' : '保存 🐾'}}</text>
      </view>
    </view>
  </view>

  <!-- AA 分摊计算器弹窗 -->
  <view wx:if="{{showSplitModal}}" class="split-mask" bindtap="closeSplitModal">
    <view class="split-card" catchtap="noop">
      <view class="split-drag-bar"></view>

      <!-- 标题 -->
      <view class="split-header">
        <text class="split-title">👥 AA 分摊</text>
        <view class="split-close" bindtap="closeSplitModal">
          <text class="split-close-icon">✕</text>
        </view>
      </view>

      <!-- 总金额提示 -->
      <view class="split-total-row">
        <text class="split-total-label">总金额</text>
        <text class="split-total-val expense-text">¥{{splitTotal}}</text>
      </view>

      <!-- 人数调整 -->
      <view class="split-people-row">
        <text class="split-people-label">分为多少人</text>
        <view class="split-people-ctrl">
          <view
            class="split-ctrl-btn {{splitPeople <= 2 ? 'split-ctrl-disabled' : ''}}"
            data-delta="-1"
            bindtap="changeSplitPeople"
          >
            <text>−</text>
          </view>
          <input
            class="split-people-input"
            type="number"
            value="{{splitPeople}}"
            bindinput="onSplitPeopleInput"
            maxlength="2"
          />
          <view
            class="split-ctrl-btn {{splitPeople >= 20 ? 'split-ctrl-disabled' : ''}}"
            data-delta="1"
            bindtap="changeSplitPeople"
          >
            <text>+</text>
          </view>
        </view>
      </view>

      <!-- 分割线 -->
      <view class="split-divider"></view>

      <!-- 每人金额结果 -->
      <view class="split-result-block">
        <view class="split-result-main">
          <text class="split-result-label">每人应付</text>
          <text class="split-result-amount expense-text">¥{{splitPerPerson}}</text>
        </view>
        <view wx:if="{{splitRemainder !== '0.00'}}" class="split-remainder-row">
          <text class="split-remainder-tip">💬 最后一人多付 ¥{{splitRemainder}}（小数补差）</text>
        </view>
      </view>

      <!-- 按钒区 -->
      <view class="split-actions">
        <view class="split-cancel-btn" bindtap="closeSplitModal">
          <text>取消</text>
        </view>
        <view class="split-confirm-btn" bindtap="confirmSplit">
          <text>填入每人金额 ✨</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 分类历史记录弹窗（长按分类触发） -->
  <view wx:if="{{showCategoryHistory}}" class="cat-history-mask" bindtap="closeCategoryHistory">
    <view class="cat-history-card" catchtap="noop">
      <view class="cat-history-drag-bar"></view>
      <view class="cat-history-header">
        <text class="cat-history-title">{{categoryHistoryTitle}}</text>
        <view class="cat-history-close" bindtap="closeCategoryHistory">
          <text class="cat-history-close-icon">✕</text>
        </view>
      </view>

      <!-- 无记录状态 -->
      <view wx:if="{{categoryHistoryEmpty}}" class="cat-history-empty">
        <text class="cat-history-empty-emoji">🌸</text>
        <text class="cat-history-empty-text">还没有这个分类的记录啊</text>
      </view>

      <!-- 历史记录列表 -->
      <view wx:else class="cat-history-list">
        <view class="cat-history-hint">点击可自动填入金额和备注</view>
        <view
          class="cat-history-item"
          wx:for="{{categoryHistoryList}}"
          wx:key="id"
          data-amount="{{item.amount}}"
          data-note="{{item.note}}"
          bindtap="tapCategoryHistoryItem"
        >
          <view class="cat-history-item-left">
            <text class="cat-history-amount">{{item.amount}}</text>
            <text wx:if="{{item.note}}" class="cat-history-note">{{item.note}}</text>
          </view>
          <text class="cat-history-date">{{item.date}}</text>
        </view>
      </view>
    </view>
  </view>

</view>
