/* pages/add/add.wxss */

/* ─── 快捷记账模板 ───────────────────────────────── */
.templates-section {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 20rpx 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(79, 184, 212, 0.08);
}

.templates-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.templates-header-left {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.templates-icon {
  font-size: 28rpx;
}

.templates-label {
  font-size: 26rpx;
  color: #3D5A6E;
  font-weight: 600;
}

.templates-hint {
  font-size: 22rpx;
  color: #C8D8E4;
}

.templates-scroll {
  width: 100%;
}

.templates-row {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  white-space: nowrap;
  padding: 4rpx 0;
}

.template-chip {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 28rpx;
  background: linear-gradient(135deg, #F5FBFD, #EBF7FB);
  border: 1.5rpx solid #D0EEF8;
  border-radius: 20rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
  min-width: 120rpx;
  gap: 6rpx;
  transition: all 0.15s;
}

.template-chip:active {
  background: #D8EEF5;
  border-color: #4FB8D4;
  transform: scale(0.96);
}

.template-chip-name {
  font-size: 24rpx;
  color: #3D5A6E;
  font-weight: 600;
  max-width: 180rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.template-chip-amount {
  font-size: 30rpx;
  font-weight: 700;
}

/* ─── 存为模板快捷入口 ───────────────────────────── */
.save-template-row {
  display: flex;
  justify-content: flex-end;
  padding: 0 4rpx 16rpx;
}

.save-template-btn {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 28rpx;
  background: #F5FBFD;
  border: 1.5rpx dashed #A8D8EA;
  border-radius: 100rpx;
  transition: all 0.15s;
}

.save-template-btn:active {
  background: #E0F5FA;
  border-color: #4FB8D4;
  transform: scale(0.97);
}

.save-template-icon {
  font-size: 26rpx;
}

.save-template-text {
  font-size: 24rpx;
  color: #5A9AAE;
  font-weight: 500;
}

/* ─── 今日速览横幅 ───────────────────────────────── */
.today-banner {
  background: linear-gradient(135deg, #E8F8FC, #F0FBFF);
  border-radius: 20rpx;
  padding: 20rpx 28rpx;
  margin-bottom: 24rpx;
  border: 1.5rpx solid #D0EEFA;
}

.today-banner-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.today-banner-left {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.today-banner-icon {
  font-size: 30rpx;
}

.today-banner-label {
  font-size: 26rpx;
  color: #7A9AAB;
}

.today-banner-right {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
}

.today-banner-expense {
  font-size: 36rpx;
  font-weight: 700;
  color: #FF8BAB;
}

.today-banner-count {
  font-size: 22rpx;
  color: #9BAAB8;
}

.today-banner-income-row {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 8rpx;
  margin-top: 8rpx;
  padding-top: 8rpx;
  border-top: 1rpx solid #D8EEF5;
}

.today-banner-income-label {
  font-size: 22rpx;
  color: #9BAAB8;
}

.today-banner-income-val {
  font-size: 26rpx;
  font-weight: 600;
  color: #4FB8D4;
}

/* 今日 vs 昨日对比行 */
.daily-compare-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 10rpx;
  padding-top: 10rpx;
  border-top: 1rpx solid #D8EEF5;
}

.daily-compare-icon {
  font-size: 22rpx;
  line-height: 1;
}

.daily-compare-text {
  font-size: 22rpx;
  color: #9BAAB8;
}

.daily-compare-up {
  color: #FF8BAB;
  font-weight: 600;
}

.daily-compare-down {
  color: #4FB8D4;
  font-weight: 600;
}

/* 本周消费速览 */
.week-compare-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 10rpx;
  padding-top: 10rpx;
  border-top: 1rpx solid #D8EEF5;
}

.week-compare-left {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.week-compare-icon {
  font-size: 22rpx;
  line-height: 1;
}

.week-compare-label {
  font-size: 22rpx;
  color: #9BAAB8;
}

.week-compare-amount {
  font-size: 22rpx;
  font-weight: 600;
}

.week-compare-days {
  font-size: 20rpx;
  color: #B8CCDA;
}

.week-compare-right {
  display: flex;
  align-items: center;
}

.week-compare-vs {
  font-size: 21rpx;
  font-weight: 600;
  border-radius: 20rpx;
  padding: 4rpx 14rpx;
}

.week-compare-vs.up {
  color: #FF8BAB;
  background: #FFF0F4;
}

.week-compare-vs.down {
  color: #4FB8D4;
  background: #EFF9FD;
}

.week-compare-top {
  font-size: 21rpx;
  color: #7EC8E3;
  background: #EFF9FD;
  border-radius: 20rpx;
  padding: 4rpx 14rpx;
}

/* 收支切换 */
.type-switcher {
  display: flex;
  background: #FFFFFF;
  border-radius: 100rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(79, 184, 212, 0.12);
}

.type-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 0;
  border-radius: 100rpx;
  font-size: 30rpx;
  color: #9BAAB8;
  transition: all 0.25s;
}

.type-btn-active-expense {
  background: #FFE0E8;
  color: #FF8BAB;
  font-weight: 600;
}

.type-btn-active-income {
  background: #E0F5FA;
  color: #4FB8D4;
  font-weight: 600;
}

/* 金额显示 */
.amount-display-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx 36rpx;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  box-shadow: 0 4rpx 16rpx rgba(79, 184, 212, 0.1);
  min-height: 120rpx;
}

.amount-unit {
  font-size: 44rpx;
  color: #9BAAB8;
  font-weight: 500;
  align-self: flex-start;
  margin-top: 16rpx;
}

.amount-display-inner {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  overflow: hidden;
}

.amount-display {
  font-size: 72rpx;
  font-weight: 700;
  letter-spacing: -2rpx;
  word-break: break-all;
}

/* 表达式求值结果行 */
.amount-result-row {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.amount-result-eq {
  font-size: 28rpx;
  color: #C8D8E4;
  font-weight: 400;
}

.amount-result {
  font-size: 36rpx;
  font-weight: 600;
  opacity: 0.75;
}

.income-text { color: #4FB8D4; }
.expense-text { color: #FF8BAB; }

/* 分类区域 */
.category-section {
  margin-bottom: 20rpx;
  padding: 24rpx 28rpx;
}

.form-label {
  font-size: 26rpx;
  color: #9BAAB8;
  margin-bottom: 20rpx;
  display: block;
}

.category-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.category-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 120rpx;
  height: 120rpx;
  border-radius: 24rpx;
  background: #F5FBFD;
  border: 2rpx solid transparent;
  transition: all 0.2s;
}

.category-item:active {
  opacity: 0.8;
}

.category-selected {
  background: #E0F5FA;
  border-color: #4FB8D4;
}

.category-emoji {
  font-size: 40rpx;
  margin-bottom: 6rpx;
}

.category-name {
  font-size: 22rpx;
  color: #3D5A6E;
}

.category-selected .category-name {
  color: #4FB8D4;
  font-weight: 600;
}

/* 表单区域 */
.form-section {
  padding: 12rpx 28rpx;
  margin-bottom: 24rpx;
}

.form-row {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
}

.form-label-inline {
  font-size: 28rpx;
  color: #3D5A6E;
  width: 120rpx;
  flex-shrink: 0;
}

.form-value {
  font-size: 28rpx;
  color: #4FB8D4;
  flex: 1;
}

.form-input {
  flex: 1;
  font-size: 28rpx;
  color: #3D5A6E;
  height: 56rpx;
  line-height: 56rpx;
}

.input-placeholder {
  color: #C8D8E4;
}

/* 快捷日期按钮组 */
.date-quick-row {
  display: flex;
  flex: 1;
  gap: 10rpx;
  flex-wrap: nowrap;
  justify-content: flex-end;
}

.date-quick-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 10rpx 20rpx;
  background: #F5FBFD;
  border: 1.5rpx solid #D8EEF5;
  border-radius: 100rpx;
  font-size: 24rpx;
  color: #5A8A9E;
  white-space: nowrap;
  transition: all 0.15s;
}

.date-quick-btn:active {
  opacity: 0.75;
  background: #E0F5FA;
}

.date-quick-active {
  background: #E0F5FA;
  border-color: #4FB8D4;
  color: #4FB8D4;
  font-weight: 600;
}

.date-quick-picker {
  min-width: 88rpx;
}

/* 常用备注快捷标签 */
.quick-notes-row {
  padding: 8rpx 0 16rpx;
}

.quick-notes-scroll {
  width: 100%;
  white-space: nowrap;
}

.quick-notes-inner {
  display: inline-flex;
  flex-direction: row;
  gap: 12rpx;
  padding: 4rpx 0;
}

.quick-note-tag {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 24rpx;
  background: #F0F8FF;
  border: 1.5rpx solid #D8EEF5;
  border-radius: 100rpx;
  font-size: 24rpx;
  color: #5A8A9E;
  white-space: nowrap;
  flex-shrink: 0;
  transition: all 0.15s;
}

.quick-note-tag:active {
  opacity: 0.75;
  background: #E0F5FA;
}

.quick-note-tag-active {
  background: #E0F5FA;
  border-color: #4FB8D4;
  color: #4FB8D4;
  font-weight: 600;
}

.divider-light {
  height: 1rpx;
  background: #F0F8FF;
}

/* ─── 最近相似记录 ───────────────────────────────── */
.recent-records-section {
  margin-bottom: 20rpx;
  padding: 20rpx 28rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(79, 184, 212, 0.08);
}

.recent-records-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.recent-records-label {
  font-size: 26rpx;
  color: #3D5A6E;
  font-weight: 600;
}

.recent-records-hint {
  font-size: 22rpx;
  color: #C8D8E4;
}

.recent-records-scroll {
  width: 100%;
  white-space: nowrap;
}

.recent-records-row {
  display: inline-flex;
  flex-direction: row;
  gap: 16rpx;
  padding: 4rpx 0;
}

.recent-record-chip {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 16rpx 28rpx;
  background: #F5FBFD;
  border: 1.5rpx solid #D8EEF5;
  border-radius: 20rpx;
  flex-shrink: 0;
  gap: 4rpx;
  min-width: 120rpx;
  transition: all 0.15s;
}

.recent-record-chip:active {
  background: #E0F5FA;
  border-color: #4FB8D4;
  transform: scale(0.97);
}

.recent-chip-amount {
  font-size: 32rpx;
  font-weight: 700;
}

.recent-chip-note {
  font-size: 22rpx;
  color: #9BAAB8;
  max-width: 160rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 数字键盘 */
.keyboard {
  background: #FFFFFF;
  border-radius: 32rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 24rpx rgba(79, 184, 212, 0.12);
  margin-bottom: 40rpx;
}

.keyboard-row {
  display: flex;
}

.key-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 112rpx;
  font-size: 40rpx;
  color: #3D5A6E;
  font-weight: 500;
  background: #FFFFFF;
  border: 1rpx solid #F0F8FF;
  cursor: pointer;
  transition: background 0.1s;
}

.key-btn:active {
  background: #EEF8FB;
}

.key-del {
  background: #FFF5F7;
  color: #FF8BAB;
}

.key-del:active {
  background: #FFE0E8;
}

.key-dot {
  color: #9BAAB8;
}

/* 运算符键（+ / −） */
.key-operator {
  background: #F0F8FF;
  color: #4FB8D4;
  font-weight: 700;
  font-size: 44rpx;
}

.key-operator:active {
  background: #D8EEF5;
}

.key-save {
  flex: 2;
  height: 112rpx;
  font-size: 32rpx;
  font-weight: 700;
  border-radius: 0;
}

.key-save-expense {
  background: linear-gradient(135deg, #FFB3C8, #FF8BAB);
  color: #FFFFFF;
}

.key-save-income {
  background: linear-gradient(135deg, #7EC8E3, #4FB8D4);
  color: #FFFFFF;
}

.key-save:active {
  opacity: 0.88;
}

/* ─── 常用金额快捷区 ─────────────────────────────────── */
.top-amounts-section {
  margin: 0 0 16rpx;
  padding: 0 24rpx;
}

.top-amounts-header {
  margin-bottom: 12rpx;
}

.top-amounts-label {
  font-size: 24rpx;
  color: #9BAAB8;
  font-weight: 500;
}

.top-amounts-scroll {
  width: 100%;
}

.top-amounts-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  white-space: nowrap;
  padding-bottom: 4rpx;
}

.top-amount-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: #F5FAFC;
  border: 2rpx solid #D8EEF5;
  border-radius: 32rpx;
  padding: 10rpx 28rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
  transition: all 0.15s;
}

.top-amount-chip:active {
  background: #D8EEF5;
  border-color: #7EC8E3;
  transform: scale(0.96);
}

.top-amount-chip-active {
  background: #E8F5FA;
  border-color: #4FB8D4;
}

.top-amount-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #4A5568;
}

.top-amount-chip-active .top-amount-text {
  color: #4FB8D4;
}

.top-amount-text.income-text {
  color: #48BB78;
}

/* ─── 备注智能联想下拉 ───────────────────────────────── */
.note-input-row {
  position: relative;
}

.note-suggestions-wrap {
  background: #FFFFFF;
  border-radius: 0 0 20rpx 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(79, 184, 212, 0.14);
  border: 1.5rpx solid #E0EFF5;
  border-top: none;
  margin: 0 -28rpx;
  overflow: hidden;
  z-index: 10;
}

.note-suggestion-item {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 20rpx 28rpx;
  border-bottom: 1rpx solid #F5FAFD;
  transition: background 0.12s;
}

.note-suggestion-item:last-child {
  border-bottom: none;
}

.note-suggestion-item:active {
  background: #EDF7FB;
}

.note-suggestion-icon {
  font-size: 28rpx;
  flex-shrink: 0;
}

.note-suggestion-text {
  font-size: 28rpx;
  color: #3D5A6E;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ─── 分类历史记录弹窗 ────────────────────────────────────── */
.cat-history-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(61, 90, 110, 0.45);
  z-index: 200;
  display: flex;
  align-items: flex-end;
}

.cat-history-card {
  width: 100%;
  background: #FFFFFF;
  border-radius: 40rpx 40rpx 0 0;
  padding: 16rpx 36rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  animation: slideUpCatHist 0.26s ease;
  max-height: 70vh;
  overflow-y: auto;
}

@keyframes slideUpCatHist {
  from { transform: translateY(100%); opacity: 0; }
  to { transform: translateY(0); opacity: 1; }
}

.cat-history-drag-bar {
  width: 72rpx;
  height: 8rpx;
  background: #DCE8EF;
  border-radius: 100rpx;
  margin: 0 auto 28rpx;
}

.cat-history-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.cat-history-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #3D5A6E;
}

.cat-history-close {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #F0F8FF;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cat-history-close-icon {
  font-size: 26rpx;
  color: #9BAAB8;
}

.cat-history-hint {
  font-size: 22rpx;
  color: #C8D8E4;
  text-align: center;
  margin-bottom: 20rpx;
}

.cat-history-list {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.cat-history-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 20rpx;
  border-radius: 20rpx;
  background: #F6FBFD;
  transition: background 0.15s;
}

.cat-history-item:active {
  background: #E0F5FA;
}

.cat-history-item-left {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  flex: 1;
  min-width: 0;
}

.cat-history-amount {
  font-size: 36rpx;
  font-weight: 700;
  color: #FF8BAB;
}

.cat-history-note {
  font-size: 24rpx;
  color: #9BAAB8;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cat-history-date {
  font-size: 24rpx;
  color: #C8D8E4;
  flex-shrink: 0;
  margin-left: 20rpx;
}

.cat-history-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0;
}

.cat-history-empty-emoji {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.cat-history-empty-text {
  font-size: 28rpx;
  color: #9BAAB8;
}

/* ======== AA 分摊计算器 ======== */

/* 金额卡片内的 AA 按钮 */
.aa-split-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  background: #FFF0F5;
  border-radius: 18rpx;
  padding: 16rpx 20rpx;
  min-width: 80rpx;
  flex-shrink: 0;
  border: 2rpx solid #FFD6E5;
  transition: background 0.15s;
}

.aa-split-btn:active {
  background: #FFD6E5;
}

.aa-split-icon {
  font-size: 32rpx;
  line-height: 1;
}

.aa-split-text {
  font-size: 20rpx;
  font-weight: 700;
  color: #FF8BAB;
  letter-spacing: 1rpx;
}

/* 遮罩 */
.split-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

/* 弹窗卡片 */
.split-card {
  background: #FFFFFF;
  border-radius: 40rpx 40rpx 0 0;
  padding: 20rpx 36rpx 60rpx;
  width: 100%;
  box-shadow: 0 -8rpx 32rpx rgba(79, 184, 212, 0.12);
}

.split-drag-bar {
  width: 80rpx;
  height: 8rpx;
  background: #E8F4F8;
  border-radius: 4rpx;
  margin: 8rpx auto 28rpx;
}

/* 标题行 */
.split-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28rpx;
}

.split-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #2D4A60;
}

.split-close {
  width: 56rpx;
  height: 56rpx;
  background: #F0F7FA;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.split-close-icon {
  font-size: 24rpx;
  color: #9BAAB8;
}

/* 总金额 */
.split-total-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #FFF8FB;
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
}

.split-total-label {
  font-size: 28rpx;
  color: #9BAAB8;
}

.split-total-val {
  font-size: 36rpx;
  font-weight: 700;
}

/* 人数调节 */
.split-people-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.split-people-label {
  font-size: 28rpx;
  color: #2D4A60;
  font-weight: 500;
}

.split-people-ctrl {
  display: flex;
  align-items: center;
  gap: 0;
  background: #F0F7FA;
  border-radius: 24rpx;
  overflow: hidden;
}

.split-ctrl-btn {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: #4FB8D4;
  font-weight: 700;
  transition: background 0.12s;
}

.split-ctrl-btn:active {
  background: #D4EEF5;
}

.split-ctrl-disabled {
  color: #C8D8E4;
}

.split-people-input {
  width: 80rpx;
  text-align: center;
  font-size: 34rpx;
  font-weight: 700;
  color: #2D4A60;
  background: transparent;
  border: none;
}

/* 分割线 */
.split-divider {
  height: 1rpx;
  background: #F0F7FA;
  margin: 4rpx 0 24rpx;
}

/* 结果展示 */
.split-result-block {
  text-align: center;
  padding: 24rpx 0;
  margin-bottom: 28rpx;
}

.split-result-main {
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.split-result-label {
  font-size: 28rpx;
  color: #9BAAB8;
}

.split-result-amount {
  font-size: 72rpx;
  font-weight: 700;
  letter-spacing: -2rpx;
}

.split-remainder-row {
  display: flex;
  justify-content: center;
}

.split-remainder-tip {
  font-size: 24rpx;
  color: #C8D8E4;
  background: #F8FAFB;
  border-radius: 20rpx;
  padding: 8rpx 20rpx;
}

/* 操作按钮 */
.split-actions {
  display: flex;
  gap: 20rpx;
}

.split-cancel-btn {
  flex: 1;
  height: 96rpx;
  background: #F0F7FA;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  color: #9BAAB8;
  font-weight: 500;
}

.split-cancel-btn:active {
  background: #E0EFF5;
}

.split-confirm-btn {
  flex: 2;
  height: 96rpx;
  background: linear-gradient(135deg, #FF8BAB 0%, #FFAEC9 100%);
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  color: #FFFFFF;
  font-weight: 600;
  box-shadow: 0 6rpx 20rpx rgba(255, 139, 171, 0.35);
}

.split-confirm-btn:active {
  opacity: 0.85;
}

/* ======== 记账成功 - 消费小结弹窗 ======== */

.save-summary-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1200;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  pointer-events: none;
}

.save-summary-card {
  width: 88%;
  background: #FFFFFF;
  border-radius: 32rpx 32rpx 28rpx 28rpx;
  padding: 36rpx 40rpx 44rpx;
  margin-bottom: 180rpx;
  box-shadow: 0 12rpx 48rpx rgba(79, 184, 212, 0.22), 0 4rpx 16rpx rgba(0,0,0,0.08);
  border: 2rpx solid rgba(79, 184, 212, 0.15);
  animation: summarySlideUp 0.32s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
}

@keyframes summarySlideUp {
  from {
    transform: translateY(60rpx);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

/* 顶部成功标识 */
.save-summary-top {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 28rpx;
}

.save-summary-check {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #4FB8D4 0%, #7EC8E3 100%);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.save-summary-title {
  font-size: 28rpx;
  color: #8A9BAB;
  font-weight: 500;
}

/* 本次记账金额行 */
.save-summary-amount-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.save-summary-cat-emoji {
  font-size: 40rpx;
  line-height: 1;
}

.save-summary-cat-name {
  font-size: 30rpx;
  color: #4A5E6E;
  font-weight: 600;
  flex: 1;
}

.save-summary-amount {
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: -0.5px;
}

/* 本月累计统计行 */
.save-summary-stat {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #F5FBFD;
  border-radius: 16rpx;
  padding: 18rpx 24rpx;
  margin-bottom: 20rpx;
}

.save-summary-stat-label {
  font-size: 26rpx;
  color: #8A9BAB;
}

.save-summary-stat-val {
  font-size: 26rpx;
  color: #4A5E6E;
  font-weight: 600;
}

/* 环比提示行 */
.save-summary-tip {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.save-summary-tip-emoji {
  font-size: 28rpx;
  line-height: 1;
}

.save-summary-tip-text {
  font-size: 26rpx;
  color: #7A8FA0;
}

/* ==========================================
   备注收藏夹
   ========================================== */

/* 备注行星号按钮 */
.note-fav-star {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  flex-shrink: 0;
  margin-left: 8rpx;
  background: #F0F8FB;
  transition: background 0.2s;
}
.note-fav-star-active {
  background: #FFF8E0;
}
.note-fav-star-icon {
  font-size: 32rpx;
  line-height: 1;
}

/* 收藏夹区块 */
.note-fav-section {
  padding: 16rpx 32rpx 8rpx;
  background: #FAFEFF;
  border-radius: 16rpx;
  margin: 4rpx 0 8rpx;
}

/* 收藏夹标题行 */
.note-fav-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 4rpx;
}
.note-fav-header-left {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.note-fav-icon {
  font-size: 28rpx;
  line-height: 1;
}
.note-fav-title {
  font-size: 26rpx;
  color: #4A5E6E;
  font-weight: 500;
}
.note-fav-count {
  font-size: 22rpx;
  color: #AABBCC;
  background: #EEF4F8;
  border-radius: 20rpx;
  padding: 2rpx 10rpx;
  min-width: 30rpx;
  text-align: center;
}
.note-fav-header-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.note-fav-manage-btn {
  font-size: 24rpx;
  color: #4FB8D4;
}
.note-fav-arrow {
  font-size: 32rpx;
  color: #AABBCC;
  display: inline-block;
  transform: rotate(90deg);
  transition: transform 0.2s;
}
.note-fav-arrow-open {
  transform: rotate(-90deg);
}

/* 收藏夹 chip 滚动列表 */
.note-fav-chips-wrap {
  padding-top: 12rpx;
}
.note-fav-chips-scroll {
  width: 100%;
}
.note-fav-chips-row {
  display: flex;
  flex-direction: row;
  gap: 12rpx;
  padding-bottom: 8rpx;
  white-space: nowrap;
}
.note-fav-chip {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 22rpx;
  border-radius: 32rpx;
  background: #EEF7FB;
  border: 2rpx solid transparent;
  flex-shrink: 0;
}
.note-fav-chip-active {
  background: #D6F0F8;
  border-color: #4FB8D4;
}
.note-fav-chip-text {
  font-size: 26rpx;
  color: #4A5E6E;
}

/* ==========================================
   备注收藏夹管理弹窗
   ========================================== */
.fav-manage-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.35);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}
.fav-manage-card {
  width: 100%;
  background: #FFFFFF;
  border-radius: 32rpx 32rpx 0 0;
  padding: 16rpx 0 40rpx;
  max-height: 70vh;
  display: flex;
  flex-direction: column;
}
.fav-manage-drag-bar {
  width: 72rpx;
  height: 8rpx;
  background: #DDE8EE;
  border-radius: 4rpx;
  margin: 0 auto 24rpx;
}
.fav-manage-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx 20rpx;
  border-bottom: 1rpx solid #EEF4F8;
}
.fav-manage-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #2D4050;
}
.fav-manage-close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.fav-manage-close-icon {
  font-size: 28rpx;
  color: #AABBCC;
}
.fav-manage-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 32rpx;
  gap: 16rpx;
}
.fav-manage-empty-emoji {
  font-size: 56rpx;
}
.fav-manage-empty-text {
  font-size: 26rpx;
  color: #AABBCC;
  text-align: center;
}
.fav-manage-list {
  flex: 1;
  overflow-y: auto;
  padding: 16rpx 0;
}
.fav-manage-item {
  display: flex;
  align-items: center;
  padding: 20rpx 32rpx;
  border-bottom: 1rpx solid #F5F9FB;
  gap: 16rpx;
}
.fav-manage-item-left {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.fav-manage-item-text {
  font-size: 28rpx;
  color: #2D4050;
}
.fav-manage-item-cat {
  font-size: 22rpx;
  color: #AABBCC;
  background: #EEF4F8;
  border-radius: 12rpx;
  padding: 2rpx 10rpx;
}
.fav-manage-item-del {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.fav-manage-item-del-icon {
  font-size: 28rpx;
}
.fav-manage-hint {
  font-size: 22rpx;
  color: #AABBCC;
  text-align: center;
  padding: 16rpx 32rpx 0;
}
