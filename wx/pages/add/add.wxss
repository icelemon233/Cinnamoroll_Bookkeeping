/* pages/add/add.wxss */

/* ─── 快捷记账模板 ───────────────────────────────── */
.templates-section {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 20rpx 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(79, 184, 212, 0.08);
}

.templates-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.templates-header-left {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.templates-icon {
  font-size: 28rpx;
}

.templates-label {
  font-size: 26rpx;
  color: #3D5A6E;
  font-weight: 600;
}

.templates-hint {
  font-size: 22rpx;
  color: #C8D8E4;
}

.templates-scroll {
  width: 100%;
}

.templates-row {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  white-space: nowrap;
  padding: 4rpx 0;
}

.template-chip {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 28rpx;
  background: linear-gradient(135deg, #F5FBFD, #EBF7FB);
  border: 1.5rpx solid #D0EEF8;
  border-radius: 20rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
  min-width: 120rpx;
  gap: 6rpx;
  transition: all 0.15s;
}

.template-chip:active {
  background: #D8EEF5;
  border-color: #4FB8D4;
  transform: scale(0.96);
}

.template-chip-name {
  font-size: 24rpx;
  color: #3D5A6E;
  font-weight: 600;
  max-width: 180rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.template-chip-amount {
  font-size: 30rpx;
  font-weight: 700;
}

/* ─── 存为模板快捷入口 ───────────────────────────── */
.save-template-row {
  display: flex;
  justify-content: flex-end;
  padding: 0 4rpx 16rpx;
}

.save-template-btn {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 28rpx;
  background: #F5FBFD;
  border: 1.5rpx dashed #A8D8EA;
  border-radius: 100rpx;
  transition: all 0.15s;
}

.save-template-btn:active {
  background: #E0F5FA;
  border-color: #4FB8D4;
  transform: scale(0.97);
}

.save-template-icon {
  font-size: 26rpx;
}

.save-template-text {
  font-size: 24rpx;
  color: #5A9AAE;
  font-weight: 500;
}

/* ─── 今日速览横幅 ───────────────────────────────── */
.today-banner {
  background: linear-gradient(135deg, #E8F8FC, #F0FBFF);
  border-radius: 20rpx;
  padding: 20rpx 28rpx;
  margin-bottom: 24rpx;
  border: 1.5rpx solid #D0EEFA;
}

.today-banner-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.today-banner-left {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.today-banner-icon {
  font-size: 30rpx;
}

.today-banner-label {
  font-size: 26rpx;
  color: #7A9AAB;
}

.today-banner-right {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
}

.today-banner-expense {
  font-size: 36rpx;
  font-weight: 700;
  color: #FF8BAB;
}

.today-banner-count {
  font-size: 22rpx;
  color: #9BAAB8;
}

.today-banner-income-row {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 8rpx;
  margin-top: 8rpx;
  padding-top: 8rpx;
  border-top: 1rpx solid #D8EEF5;
}

.today-banner-income-label {
  font-size: 22rpx;
  color: #9BAAB8;
}

.today-banner-income-val {
  font-size: 26rpx;
  font-weight: 600;
  color: #4FB8D4;
}

/* 收支切换 */
.type-switcher {
  display: flex;
  background: #FFFFFF;
  border-radius: 100rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(79, 184, 212, 0.12);
}

.type-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 0;
  border-radius: 100rpx;
  font-size: 30rpx;
  color: #9BAAB8;
  transition: all 0.25s;
}

.type-btn-active-expense {
  background: #FFE0E8;
  color: #FF8BAB;
  font-weight: 600;
}

.type-btn-active-income {
  background: #E0F5FA;
  color: #4FB8D4;
  font-weight: 600;
}

/* 金额显示 */
.amount-display-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx 36rpx;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  box-shadow: 0 4rpx 16rpx rgba(79, 184, 212, 0.1);
  min-height: 120rpx;
}

.amount-unit {
  font-size: 44rpx;
  color: #9BAAB8;
  font-weight: 500;
  align-self: flex-start;
  margin-top: 16rpx;
}

.amount-display-inner {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  overflow: hidden;
}

.amount-display {
  font-size: 72rpx;
  font-weight: 700;
  letter-spacing: -2rpx;
  word-break: break-all;
}

/* 表达式求值结果行 */
.amount-result-row {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.amount-result-eq {
  font-size: 28rpx;
  color: #C8D8E4;
  font-weight: 400;
}

.amount-result {
  font-size: 36rpx;
  font-weight: 600;
  opacity: 0.75;
}

.income-text { color: #4FB8D4; }
.expense-text { color: #FF8BAB; }

/* 分类区域 */
.category-section {
  margin-bottom: 20rpx;
  padding: 24rpx 28rpx;
}

.form-label {
  font-size: 26rpx;
  color: #9BAAB8;
  margin-bottom: 20rpx;
  display: block;
}

.category-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.category-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 120rpx;
  height: 120rpx;
  border-radius: 24rpx;
  background: #F5FBFD;
  border: 2rpx solid transparent;
  transition: all 0.2s;
}

.category-item:active {
  opacity: 0.8;
}

.category-selected {
  background: #E0F5FA;
  border-color: #4FB8D4;
}

.category-emoji {
  font-size: 40rpx;
  margin-bottom: 6rpx;
}

.category-name {
  font-size: 22rpx;
  color: #3D5A6E;
}

.category-selected .category-name {
  color: #4FB8D4;
  font-weight: 600;
}

/* 表单区域 */
.form-section {
  padding: 12rpx 28rpx;
  margin-bottom: 24rpx;
}

.form-row {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
}

.form-label-inline {
  font-size: 28rpx;
  color: #3D5A6E;
  width: 120rpx;
  flex-shrink: 0;
}

.form-value {
  font-size: 28rpx;
  color: #4FB8D4;
  flex: 1;
}

.form-input {
  flex: 1;
  font-size: 28rpx;
  color: #3D5A6E;
  height: 56rpx;
  line-height: 56rpx;
}

.input-placeholder {
  color: #C8D8E4;
}

/* 快捷日期按钮组 */
.date-quick-row {
  display: flex;
  flex: 1;
  gap: 10rpx;
  flex-wrap: nowrap;
  justify-content: flex-end;
}

.date-quick-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 10rpx 20rpx;
  background: #F5FBFD;
  border: 1.5rpx solid #D8EEF5;
  border-radius: 100rpx;
  font-size: 24rpx;
  color: #5A8A9E;
  white-space: nowrap;
  transition: all 0.15s;
}

.date-quick-btn:active {
  opacity: 0.75;
  background: #E0F5FA;
}

.date-quick-active {
  background: #E0F5FA;
  border-color: #4FB8D4;
  color: #4FB8D4;
  font-weight: 600;
}

.date-quick-picker {
  min-width: 88rpx;
}

/* 常用备注快捷标签 */
.quick-notes-row {
  padding: 8rpx 0 16rpx;
}

.quick-notes-scroll {
  width: 100%;
  white-space: nowrap;
}

.quick-notes-inner {
  display: inline-flex;
  flex-direction: row;
  gap: 12rpx;
  padding: 4rpx 0;
}

.quick-note-tag {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 24rpx;
  background: #F0F8FF;
  border: 1.5rpx solid #D8EEF5;
  border-radius: 100rpx;
  font-size: 24rpx;
  color: #5A8A9E;
  white-space: nowrap;
  flex-shrink: 0;
  transition: all 0.15s;
}

.quick-note-tag:active {
  opacity: 0.75;
  background: #E0F5FA;
}

.quick-note-tag-active {
  background: #E0F5FA;
  border-color: #4FB8D4;
  color: #4FB8D4;
  font-weight: 600;
}

.divider-light {
  height: 1rpx;
  background: #F0F8FF;
}

/* ─── 最近相似记录 ───────────────────────────────── */
.recent-records-section {
  margin-bottom: 20rpx;
  padding: 20rpx 28rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(79, 184, 212, 0.08);
}

.recent-records-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.recent-records-label {
  font-size: 26rpx;
  color: #3D5A6E;
  font-weight: 600;
}

.recent-records-hint {
  font-size: 22rpx;
  color: #C8D8E4;
}

.recent-records-scroll {
  width: 100%;
  white-space: nowrap;
}

.recent-records-row {
  display: inline-flex;
  flex-direction: row;
  gap: 16rpx;
  padding: 4rpx 0;
}

.recent-record-chip {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 16rpx 28rpx;
  background: #F5FBFD;
  border: 1.5rpx solid #D8EEF5;
  border-radius: 20rpx;
  flex-shrink: 0;
  gap: 4rpx;
  min-width: 120rpx;
  transition: all 0.15s;
}

.recent-record-chip:active {
  background: #E0F5FA;
  border-color: #4FB8D4;
  transform: scale(0.97);
}

.recent-chip-amount {
  font-size: 32rpx;
  font-weight: 700;
}

.recent-chip-note {
  font-size: 22rpx;
  color: #9BAAB8;
  max-width: 160rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 数字键盘 */
.keyboard {
  background: #FFFFFF;
  border-radius: 32rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 24rpx rgba(79, 184, 212, 0.12);
  margin-bottom: 40rpx;
}

.keyboard-row {
  display: flex;
}

.key-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 112rpx;
  font-size: 40rpx;
  color: #3D5A6E;
  font-weight: 500;
  background: #FFFFFF;
  border: 1rpx solid #F0F8FF;
  cursor: pointer;
  transition: background 0.1s;
}

.key-btn:active {
  background: #EEF8FB;
}

.key-del {
  background: #FFF5F7;
  color: #FF8BAB;
}

.key-del:active {
  background: #FFE0E8;
}

.key-dot {
  color: #9BAAB8;
}

/* 运算符键（+ / −） */
.key-operator {
  background: #F0F8FF;
  color: #4FB8D4;
  font-weight: 700;
  font-size: 44rpx;
}

.key-operator:active {
  background: #D8EEF5;
}

.key-save {
  flex: 2;
  height: 112rpx;
  font-size: 32rpx;
  font-weight: 700;
  border-radius: 0;
}

.key-save-expense {
  background: linear-gradient(135deg, #FFB3C8, #FF8BAB);
  color: #FFFFFF;
}

.key-save-income {
  background: linear-gradient(135deg, #7EC8E3, #4FB8D4);
  color: #FFFFFF;
}

.key-save:active {
  opacity: 0.88;
}

/* ─── 常用金额快捷区 ─────────────────────────────────── */
.top-amounts-section {
  margin: 0 0 16rpx;
  padding: 0 24rpx;
}

.top-amounts-header {
  margin-bottom: 12rpx;
}

.top-amounts-label {
  font-size: 24rpx;
  color: #9BAAB8;
  font-weight: 500;
}

.top-amounts-scroll {
  width: 100%;
}

.top-amounts-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  white-space: nowrap;
  padding-bottom: 4rpx;
}

.top-amount-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: #F5FAFC;
  border: 2rpx solid #D8EEF5;
  border-radius: 32rpx;
  padding: 10rpx 28rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
  transition: all 0.15s;
}

.top-amount-chip:active {
  background: #D8EEF5;
  border-color: #7EC8E3;
  transform: scale(0.96);
}

.top-amount-chip-active {
  background: #E8F5FA;
  border-color: #4FB8D4;
}

.top-amount-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #4A5568;
}

.top-amount-chip-active .top-amount-text {
  color: #4FB8D4;
}

.top-amount-text.income-text {
  color: #48BB78;
}

/* ─── 备注智能联想下拉 ───────────────────────────────── */
.note-input-row {
  position: relative;
}

.note-suggestions-wrap {
  background: #FFFFFF;
  border-radius: 0 0 20rpx 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(79, 184, 212, 0.14);
  border: 1.5rpx solid #E0EFF5;
  border-top: none;
  margin: 0 -28rpx;
  overflow: hidden;
  z-index: 10;
}

.note-suggestion-item {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 20rpx 28rpx;
  border-bottom: 1rpx solid #F5FAFD;
  transition: background 0.12s;
}

.note-suggestion-item:last-child {
  border-bottom: none;
}

.note-suggestion-item:active {
  background: #EDF7FB;
}

.note-suggestion-icon {
  font-size: 28rpx;
  flex-shrink: 0;
}

.note-suggestion-text {
  font-size: 28rpx;
  color: #3D5A6E;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
