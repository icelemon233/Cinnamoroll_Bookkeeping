<!-- pages/list/list.wxml - 账单列表页 -->
<view class="container">

  <!-- 搜索框 -->
  <view class="search-bar">
    <view class="search-inner">
      <text class="search-icon">🔍</text>
      <input
        class="search-input"
        placeholder="搜索备注、分类、金额"
        placeholder-class="search-placeholder"
        value="{{searchKeyword}}"
        bindinput="onSearchInput"
        bindfocus="onSearchFocus"
        bindblur="onSearchBlur"
        bindconfirm="onSearchConfirm"
        confirm-type="search"
      />
      <view wx:if="{{searchKeyword}}" class="search-clear" bindtap="clearSearch">
        <text class="clear-icon">✕</text>
      </view>
    </view>
  </view>

  <!-- 搜索历史浮层（聚焦且有历史时显示） -->
  <view wx:if="{{showSearchHistory && searchHistory.length > 0}}" class="search-history-panel">
    <view class="search-history-header">
      <text class="search-history-title">🕐 最近搜索</text>
      <view class="search-history-clear" bindtap="onClearAllHistory">
        <text class="search-history-clear-text">清空</text>
      </view>
    </view>
    <view class="search-history-list">
      <view
        class="search-history-item"
        wx:for="{{searchHistory}}"
        wx:key="*this"
        data-keyword="{{item}}"
        bindtap="onHistoryTap"
      >
        <text class="search-history-icon">🔍</text>
        <text class="search-history-kw">{{item}}</text>
        <view
          class="search-history-del"
          data-keyword="{{item}}"
          catchtap="onDeleteHistory"
        >
          <text class="search-history-del-icon">✕</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 搜索模式：结果数提示 -->
  <view wx:if="{{isSearchMode}}" class="search-result-hint">
    <text class="hint-text">找到 {{searchResultCount}} 条结果</text>
  </view>

  <!-- 月份切换导航（搜索模式下隐藏） -->
  <view wx:if="{{!isSearchMode}}" class="month-nav">
    <view class="month-arrow" bindtap="prevMonth">
      <text class="arrow-text">‹</text>
    </view>
    <text class="month-nav-title">{{currentMonthLabel}}</text>
    <view class="month-arrow {{isLatestMonth ? 'arrow-disabled' : ''}}" bindtap="nextMonth">
      <text class="arrow-text">›</text>
    </view>
  </view>

  <!-- 顶部汇总（搜索模式下隐藏） -->
  <view wx:if="{{!isSearchMode}}" class="summary-bar">
    <view class="summary-bar-item">
      <text class="bar-label">收入</text>
      <text class="bar-amount income-text">+{{totalIncome}}</text>
    </view>
    <view class="bar-divider"></view>
    <view class="summary-bar-item">
      <text class="bar-label">支出</text>
      <text class="bar-amount expense-text">-{{totalExpense}}</text>
    </view>
  </view>

  <!-- 本月 TOP 消费卡片（仅非搜索、非空数据时显示） -->
  <view wx:if="{{!isSearchMode && showTopCard}}" class="top-card card">
    <view class="top-card-header">
      <text class="top-card-title">🏆 本月支出 TOP</text>
      <text class="top-card-sub">点击可快速筛选</text>
    </view>
    <view class="top-card-list">
      <view
        class="top-cat-item {{filterCategory === item.category && filterType === 'expense' ? 'top-cat-active' : ''}}"
        wx:for="{{topCategories}}"
        wx:key="category"
        data-category="{{item.category}}"
        bindtap="onTopCategoryTap"
      >
        <view class="top-cat-rank">
          <text class="top-rank-text">{{item.isTop1 ? '👑' : (index + 1)}}</text>
        </view>
        <text class="top-cat-emoji">{{item.emoji}}</text>
        <view class="top-cat-body">
          <text class="top-cat-name">{{item.category}}</text>
          <view class="top-cat-bar-wrap">
            <view class="top-cat-bar" style="width: {{item.percent}}%"></view>
          </view>
        </view>
        <view class="top-cat-right">
          <text class="top-cat-amount">¥{{item.amount}}</text>
          <text class="top-cat-percent">{{item.percent}}%</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 类型筛选 -->
  <view class="filter-row">
    <view class="filter-btn {{filterType === 'all' ? 'filter-active' : ''}}" data-type="all" bindtap="switchFilter">全部</view>
    <view class="filter-btn {{filterType === 'expense' ? 'filter-active filter-expense' : ''}}" data-type="expense" bindtap="switchFilter">支出</view>
    <view class="filter-btn {{filterType === 'income' ? 'filter-active filter-income' : ''}}" data-type="income" bindtap="switchFilter">收入</view>
    <view class="sort-btn {{sortMode === 'amount' ? 'sort-btn-active' : ''}}" bindtap="toggleSortMode">
      <text class="sort-icon">{{sortMode === 'amount' ? '💰' : '📅'}}</text>
    </view>
    <view class="export-btn" bindtap="onExport">
      <text class="export-icon">📤</text>
    </view>
  </view>

  <!-- 分类筛选芯片（有分类数据时显示） -->
  <view wx:if="{{categoryChips.length > 0}}" class="category-chips-wrap">
    <scroll-view scroll-x class="category-chips-scroll" enhanced="{{true}}" show-scrollbar="{{false}}">
      <view class="category-chips-row">
        <view
          class="category-chip {{filterCategory === '' ? 'chip-active' : ''}}"
          bindtap="selectCategoryChip"
          data-name=""
        >
          <text class="chip-text">全部</text>
        </view>
        <view
          class="category-chip {{filterCategory === item.name ? 'chip-active' : ''}}"
          wx:for="{{categoryChips}}"
          wx:key="name"
          data-name="{{item.name}}"
          bindtap="selectCategoryChip"
        >
          <text class="chip-emoji">{{item.emoji}}</text>
          <text class="chip-text">{{item.name}}</text>
          <text class="chip-count">{{item.count}}</text>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 操作提示 / 多选模式提示栏 -->
  <view wx:if="{{!isEmpty}}">
    <view wx:if="{{isSelectMode}}" class="select-hint-bar">
      <view class="select-all-btn" bindtap="toggleSelectAll">
        <text class="select-all-text">全选</text>
      </view>
      <text class="select-count-text">已选 {{selectedCount}} 条</text>
      <view class="select-exit-btn" bindtap="exitSelectMode">
        <text class="select-exit-text">取消</text>
      </view>
    </view>
    <view wx:else class="hint-bar hint-bar-row" wx:if="{{!isSearchMode}}">
      <text class="hint-text">共 {{searchResultCount}} 条</text>
      <text class="hint-divider">·</text>
      <text class="hint-text sort-hint {{sortMode === 'amount' ? 'sort-hint-active' : ''}}" bindtap="toggleSortMode">
        {{sortMode === 'amount' ? '💰 按金额' : '📅 按日期'}}
      </text>
    </view>
  </view>

  <!-- 空状态 -->
  <view wx:if="{{isEmpty}}" class="empty-state">
    <text class="empty-emoji">{{isSearchMode ? '🔍' : '🌸'}}</text>
    <text class="empty-text">{{isSearchMode ? '没找到相关账单' : currentMonthLabel + '暂无账单'}}</text>
    <view wx:if="{{!isSearchMode}}" class="add-btn" bindtap="goToAdd">
      <text>去记账 ✏️</text>
    </view>
  </view>

  <!-- 账单列表（按日期分组） -->
  <view wx:else>
    <view class="date-group card" wx:for="{{allGroups}}" wx:key="date">
      <view class="group-header">
        <text class="group-date">{{item.dateLabel}} ({{item.date}})</text>
        <view class="group-subtotal">
          <text wx:if="{{item.groupIncome > 0}}" class="subtotal-income">+{{item.groupIncome}}</text>
          <text wx:if="{{item.groupExpense > 0}}" class="subtotal-expense"> -{{item.groupExpense}}</text>
        </view>
      </view>
      <view
        class="record-item {{isSelectMode && selectedIds.includes(record.id + '') ? 'record-item-selected' : ''}}"
        wx:for="{{item.records}}"
        wx:for-item="record"
        wx:key="id"
        data-id="{{record.id}}"
        bindtap="onRecordTap"
        bindlongpress="onLongPress"
      >
        <!-- 多选模式勾选框 -->
        <view wx:if="{{isSelectMode}}" class="record-checkbox {{selectedIds.includes(record.id + '') ? 'record-checkbox-checked' : ''}}">
          <text wx:if="{{selectedIds.includes(record.id + '')}}" class="checkbox-check">✓</text>
        </view>
        <view class="record-icon"><text>{{record.emoji}}</text></view>
        <view class="record-body">
          <text class="record-category">{{record.category}}</text>
          <text class="record-note" wx:if="{{record.note}}">{{record.note}}</text>
        </view>
        <view class="record-right">
          <text class="record-amount {{record.type === 'income' ? 'income-text' : 'expense-text'}}">{{record.amountDisplay}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 多选模式底部占位（避免操作栏遮挡内容） -->
  <view wx:if="{{isSelectMode}}" class="batch-spacer"></view>

  <!-- 多选模式底部操作栏 -->
  <view wx:if="{{isSelectMode}}" class="batch-action-bar">
    <view class="batch-cancel-btn" bindtap="exitSelectMode">
      <text>取消</text>
    </view>
    <view class="batch-delete-btn {{selectedCount === 0 ? 'batch-btn-disabled' : ''}}" bindtap="deleteSelected">
      <text class="batch-delete-icon">🗑️</text>
      <text>删除{{selectedCount > 0 ? ' ' + selectedCount + ' 条' : ''}}</text>
    </view>
  </view>

  <!-- 账单详情弹窗 -->
  <view wx:if="{{showDetail}}" class="detail-mask" bindtap="onMaskTap">
    <view class="detail-card" catchtap="onCardTap">
      <!-- 拖动条 -->
      <view class="detail-drag-bar"></view>

      <!-- 分类图标 + 金额 -->
      <view class="detail-header">
        <view class="detail-emoji-wrap">
          <text class="detail-emoji">{{detailRecord.emoji}}</text>
        </view>
        <view class="detail-amount-wrap">
          <text class="detail-amount {{detailRecord.type === 'income' ? 'income-text' : 'expense-text'}}">
            {{detailRecord.type === 'income' ? '+' : '-'}}{{detailRecord.amount}}
          </text>
          <text class="detail-type-label">{{detailRecord.type === 'income' ? '收入' : '支出'}}</text>
        </view>
      </view>

      <!-- 详细信息行 -->
      <view class="detail-info-list">
        <view class="detail-info-row">
          <text class="detail-info-label">分类</text>
          <text class="detail-info-value">{{detailRecord.emoji}} {{detailRecord.category}}</text>
        </view>
        <view class="detail-info-row">
          <text class="detail-info-label">日期</text>
          <text class="detail-info-value">{{detailRecord.date}}</text>
        </view>
        <view class="detail-info-row" wx:if="{{detailRecord.note}}">
          <text class="detail-info-label">备注</text>
          <text class="detail-info-value detail-note-value">{{detailRecord.note}}</text>
        </view>
      </view>

      <!-- 操作按钮 -->
      <view class="detail-actions">
        <view class="detail-action-btn detail-edit-btn" bindtap="onDetailEdit">
          <text class="detail-action-icon">✏️</text>
          <text class="detail-action-text">编辑</text>
        </view>
        <view class="detail-action-btn detail-delete-btn" bindtap="onDetailDelete">
          <text class="detail-action-icon">🗑️</text>
          <text class="detail-action-text">删除</text>
        </view>
      </view>
    </view>
  </view>

</view>
