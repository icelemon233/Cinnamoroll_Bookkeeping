/* pages/list/list.wxss */

/* ─── 搜索框 ─────────────────────────────────────────────── */
.search-bar {
  margin-bottom: 16rpx;
}

.search-inner {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 100rpx;
  padding: 18rpx 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(79, 184, 212, 0.08);
}

.search-icon {
  font-size: 30rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #3D5A6E;
  height: 48rpx;
  line-height: 48rpx;
}

.search-placeholder {
  color: #C8D8E4;
}

.search-clear {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #E8F4F8;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-left: 12rpx;
}

.clear-icon {
  font-size: 22rpx;
  color: #9BAAB8;
}

.search-result-hint {
  text-align: center;
  margin-bottom: 16rpx;
}

/* ─── 搜索历史面板 ──────────────────────────────────────── */
.search-history-panel {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 4rpx 20rpx rgba(79, 184, 212, 0.12);
}

.search-history-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.search-history-title {
  font-size: 26rpx;
  color: #9BAAB8;
  font-weight: 500;
}

.search-history-clear {
  padding: 8rpx 20rpx;
  border-radius: 100rpx;
  background: #F0F8FF;
}

.search-history-clear-text {
  font-size: 24rpx;
  color: #B0C4D0;
}

.search-history-list {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.search-history-item {
  display: flex;
  align-items: center;
  padding: 18rpx 16rpx;
  border-radius: 16rpx;
  gap: 16rpx;
  transition: background 0.15s;
}

.search-history-item:active {
  background: #F0F8FF;
}

.search-history-icon {
  font-size: 26rpx;
  flex-shrink: 0;
  opacity: 0.5;
}

.search-history-kw {
  flex: 1;
  font-size: 28rpx;
  color: #3D5A6E;
  font-weight: 400;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.search-history-del {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.search-history-del:active {
  background: #FFE0E8;
}

.search-history-del-icon {
  font-size: 22rpx;
  color: #C8D8E4;
}

/* ─── 月份切换导航栏 ──────────────────────────────────────── */
.month-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 0 20rpx;
}

.month-arrow {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #EBF7FB;
}

.arrow-text {
  font-size: 48rpx;
  color: #4FB8D4;
  font-weight: 700;
  line-height: 1;
  margin-top: -4rpx;
}

.arrow-disabled {
  opacity: 0.3;
}

.month-nav-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #3D5A6E;
}

/* ─── 顶部汇总 ───────────────────────────────────────────── */
.summary-bar {
  display: flex;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 28rpx 36rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(79, 184, 212, 0.1);
  align-items: center;
  justify-content: center;
}

.summary-bar-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.bar-label {
  font-size: 24rpx;
  color: #9BAAB8;
  margin-bottom: 8rpx;
}

.bar-amount {
  font-size: 40rpx;
  font-weight: 700;
}

.bar-divider {
  width: 1rpx;
  height: 60rpx;
  background: #E8F4F8;
  margin: 0 20rpx;
}

.income-text { color: #4FB8D4; }
.expense-text { color: #FF8BAB; }

/* ─── 本月 TOP 消费卡片 ──────────────────────────────────── */
.top-card {
  padding: 28rpx 32rpx 24rpx;
  margin-bottom: 20rpx;
}

.top-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.top-card-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #3D5A6E;
}

.top-card-sub {
  font-size: 22rpx;
  color: #C8D8E4;
}

.top-card-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.top-cat-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 20rpx;
  border-radius: 20rpx;
  background: #F6FBFD;
  transition: all 0.18s;
}

.top-cat-item:active {
  opacity: 0.75;
}

.top-cat-active {
  background: #E0F5FA;
  border: 2rpx solid #A8D8EA;
}

.top-cat-rank {
  width: 44rpx;
  text-align: center;
  flex-shrink: 0;
}

.top-rank-text {
  font-size: 26rpx;
  color: #9BAAB8;
  font-weight: 700;
}

.top-cat-emoji {
  font-size: 36rpx;
  flex-shrink: 0;
}

.top-cat-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  min-width: 0;
}

.top-cat-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #3D5A6E;
}

.top-cat-bar-wrap {
  height: 8rpx;
  background: #E8F4F8;
  border-radius: 100rpx;
  overflow: hidden;
}

.top-cat-bar {
  height: 100%;
  background: linear-gradient(90deg, #FF8BAB, #FFCCD8);
  border-radius: 100rpx;
  min-width: 8rpx;
  transition: width 0.4s ease;
}

.top-cat-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  flex-shrink: 0;
}

.top-cat-amount {
  font-size: 30rpx;
  font-weight: 700;
  color: #FF8BAB;
}

.top-cat-percent {
  font-size: 22rpx;
  color: #B0C4D0;
  margin-top: 4rpx;
}

/* ─── 筛选行 ─────────────────────────────────────────────── */
.filter-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
  align-items: center;
}

.filter-btn {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 100rpx;
  font-size: 28rpx;
  color: #9BAAB8;
  background: #FFFFFF;
  border: 2rpx solid transparent;
  font-weight: 400;
  transition: all 0.2s;
}

.filter-active {
  background: #E0F5FA;
  color: #4FB8D4;
  border-color: #A8D8EA;
  font-weight: 600;
}

.filter-expense.filter-active {
  background: #FFE0E8;
  color: #FF8BAB;
  border-color: #FFB3C8;
}

.sort-btn {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #FFFFFF;
  border: 2rpx solid #E8F4F8;
  flex-shrink: 0;
  transition: all 0.2s;
}

.sort-btn-active {
  background: #FFF8E0;
  border-color: #FFD97A;
}

.sort-icon {
  font-size: 32rpx;
}

.export-btn {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #FFFFFF;
  border: 2rpx solid #E8F4F8;
  flex-shrink: 0;
}

.export-icon {
  font-size: 32rpx;
}

/* ─── 日期分组卡片 ────────────────────────────────────────── */
.date-group {
  padding: 20rpx 28rpx;
  margin-bottom: 20rpx;
}

.group-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #F0F8FF;
  margin-bottom: 8rpx;
}

.group-date {
  font-size: 26rpx;
  color: #9BAAB8;
  font-weight: 500;
}

.group-subtotal {
  display: flex;
  gap: 8rpx;
}

.subtotal-income {
  font-size: 26rpx;
  color: #4FB8D4;
}

.subtotal-expense {
  font-size: 26rpx;
  color: #FF8BAB;
}

/* ─── 账单条目 ───────────────────────────────────────────── */
.record-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F8FCFE;
}

.record-item:last-child {
  border-bottom: none;
  padding-bottom: 4rpx;
}

.record-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #EEF8FB;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.record-body {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.record-category {
  font-size: 30rpx;
  font-weight: 500;
  color: #3D5A6E;
}

.record-note {
  font-size: 24rpx;
  color: #9BAAB8;
  margin-top: 4rpx;
}

.record-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  flex-shrink: 0;
}

.record-amount {
  font-size: 34rpx;
  font-weight: 700;
}

.record-edit-hint {
  font-size: 20rpx;
  color: #C8D8E4;
  margin-top: 4rpx;
}

/* ─── 空状态 ─────────────────────────────────────────────── */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}

.empty-emoji {
  font-size: 100rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #9BAAB8;
  margin-bottom: 40rpx;
}

.add-btn {
  background: linear-gradient(135deg, #7EC8E3, #4FB8D4);
  color: #FFFFFF;
  padding: 24rpx 60rpx;
  border-radius: 100rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.add-btn:active {
  opacity: 0.85;
}

/* ─── 分类筛选芯片 ──────────────────────────────────────── */
.category-chips-wrap {
  margin-bottom: 20rpx;
}

.category-chips-scroll {
  width: 100%;
  white-space: nowrap;
}

.category-chips-row {
  display: inline-flex;
  gap: 16rpx;
  padding: 4rpx 4rpx 8rpx;
}

.category-chip {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 14rpx 24rpx;
  border-radius: 100rpx;
  background: #FFFFFF;
  border: 2rpx solid #E8F4F8;
  flex-shrink: 0;
  transition: all 0.2s;
}

.category-chip:active {
  opacity: 0.75;
}

.chip-active {
  background: #E0F5FA;
  border-color: #A8D8EA;
}

.chip-emoji {
  font-size: 28rpx;
  line-height: 1;
}

.chip-text {
  font-size: 26rpx;
  color: #3D5A6E;
  font-weight: 500;
}

.chip-active .chip-text {
  color: #4FB8D4;
  font-weight: 600;
}

.chip-count {
  font-size: 22rpx;
  color: #9BAAB8;
  background: #F0F8FF;
  border-radius: 100rpx;
  padding: 2rpx 12rpx;
  min-width: 32rpx;
  text-align: center;
}

.chip-active .chip-count {
  background: #C8EEFA;
  color: #4FB8D4;
}

/* ─── 提示栏 ─────────────────────────────────────────────── */
.hint-bar {
  text-align: center;
  margin-bottom: 16rpx;
}

.hint-bar-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.hint-text {
  font-size: 24rpx;
  color: #B8D8E4;
}

.hint-divider {
  font-size: 24rpx;
  color: #D8EEF5;
}

.sort-hint {
  cursor: pointer;
}

.sort-hint-active {
  color: #F5B800;
  font-weight: 500;
}

/* ─── 账单详情弹窗 ──────────────────────────────────────── */
.detail-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(61, 90, 110, 0.45);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}

.detail-card {
  width: 100%;
  background: #FFFFFF;
  border-radius: 40rpx 40rpx 0 0;
  padding: 20rpx 40rpx 60rpx;
  box-sizing: border-box;
  animation: slideUp 0.28s ease;
}

@keyframes slideUp {
  from { transform: translateY(100%); opacity: 0; }
  to { transform: translateY(0); opacity: 1; }
}

.detail-drag-bar {
  width: 80rpx;
  height: 8rpx;
  background: #DCE8EF;
  border-radius: 100rpx;
  margin: 0 auto 36rpx;
}

.detail-header {
  display: flex;
  align-items: center;
  gap: 32rpx;
  margin-bottom: 40rpx;
}

.detail-emoji-wrap {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #E8F8FB, #D0F0F8);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.detail-emoji {
  font-size: 56rpx;
}

.detail-amount-wrap {
  display: flex;
  flex-direction: column;
}

.detail-amount {
  font-size: 56rpx;
  font-weight: 800;
  letter-spacing: -1rpx;
  line-height: 1.1;
}

.detail-type-label {
  font-size: 26rpx;
  color: #9BAAB8;
  margin-top: 6rpx;
}

.detail-info-list {
  background: #F6FBFD;
  border-radius: 24rpx;
  padding: 8rpx 28rpx;
  margin-bottom: 40rpx;
}

.detail-info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #EDF6FA;
}

.detail-info-row:last-child {
  border-bottom: none;
}

.detail-info-label {
  font-size: 28rpx;
  color: #9BAAB8;
  flex-shrink: 0;
}

.detail-info-value {
  font-size: 28rpx;
  color: #3D5A6E;
  font-weight: 500;
  text-align: right;
  max-width: 70%;
}

.detail-note-value {
  color: #5A7A8E;
  font-weight: 400;
}

.detail-actions {
  display: flex;
  gap: 24rpx;
}

.detail-action-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 28rpx 0;
  border-radius: 24rpx;
}

.detail-action-btn:active {
  opacity: 0.8;
}

.detail-edit-btn {
  background: linear-gradient(135deg, #C8EEFA, #A8D8EA);
}

.detail-delete-btn {
  background: linear-gradient(135deg, #FFE0E8, #FFCCD8);
}

.detail-action-icon {
  font-size: 36rpx;
}

.detail-action-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #3D5A6E;
}

.detail-edit-btn .detail-action-text {
  color: #3E90A6;
}

.detail-delete-btn .detail-action-text {
  color: #E06080;
}

/* ─── 多选模式 ───────────────────────────────────────────── */

/* 多选提示栏（替换普通 hint-bar） */
.select-hint-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 32rpx;
  background: #EEF8FB;
  border-radius: 16rpx;
  margin: 0 24rpx 16rpx;
}

.select-all-btn {
  padding: 8rpx 20rpx;
  background: #4FB8D4;
  border-radius: 20rpx;
}

.select-all-text {
  font-size: 26rpx;
  color: #fff;
  font-weight: 500;
}

.select-count-text {
  font-size: 28rpx;
  color: #3D5A6E;
  font-weight: 500;
}

.select-exit-btn {
  padding: 8rpx 20rpx;
  background: #CBD8E0;
  border-radius: 20rpx;
}

.select-exit-text {
  font-size: 26rpx;
  color: #5A7585;
}

/* 条目选中态 */
.record-item-selected {
  background: #EEF8FB;
  border-radius: 12rpx;
  margin: 0 -8rpx;
  padding-left: 8rpx !important;
  padding-right: 8rpx !important;
}

/* 勾选框 */
.record-checkbox {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 3rpx solid #CBD8E0;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  flex-shrink: 0;
  background: #fff;
  transition: all 0.15s;
}

.record-checkbox-checked {
  background: #4FB8D4;
  border-color: #4FB8D4;
}

.checkbox-check {
  font-size: 26rpx;
  color: #fff;
  font-weight: 700;
  line-height: 1;
}

/* 底部批量操作栏 */
.batch-action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -4rpx 24rpx rgba(79, 184, 212, 0.15);
  gap: 20rpx;
  z-index: 100;
}

.batch-cancel-btn {
  flex: 1;
  padding: 24rpx 0;
  border-radius: 48rpx;
  border: 2rpx solid #CBD8E0;
  text-align: center;
  font-size: 30rpx;
  color: #5A7585;
}

.batch-delete-btn {
  flex: 2;
  padding: 24rpx 0;
  border-radius: 48rpx;
  background: linear-gradient(135deg, #FF8BAB, #FF6090);
  text-align: center;
  font-size: 30rpx;
  color: #fff;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.batch-btn-disabled {
  background: #CBD8E0;
}

.batch-delete-icon {
  font-size: 30rpx;
}

/* 多选模式时页面底部留白，避免被操作栏遮挡 */
page.select-mode-active {
  padding-bottom: 160rpx;
}

/* 多选模式底部占位 */
.batch-spacer {
  height: 160rpx;
}

/* ─── 搜索结果统计摘要条 ──────────────────────────────────── */
.stats-summary-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 20rpx 32rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(79, 184, 212, 0.08);
  gap: 0;
}

.stats-summary-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.stats-summary-label {
  font-size: 22rpx;
  color: #9BAAB8;
}

.stats-summary-amount {
  font-size: 32rpx;
  font-weight: 700;
}

.stats-summary-divider {
  width: 1rpx;
  height: 48rpx;
  background: #E8F4F8;
  margin: 0 24rpx;
  flex-shrink: 0;
}

/* ─── 月份模式统计摘要行（均值/最大值） ──────────────────── */
.stats-detail-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #F8FCFE;
  border-radius: 0 0 20rpx 20rpx;
  padding: 16rpx 32rpx;
  margin-top: -16rpx;
  margin-bottom: 20rpx;
  gap: 0;
}

.stats-detail-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.stats-detail-label {
  font-size: 20rpx;
  color: #B8D0DC;
}

.stats-detail-val {
  font-size: 26rpx;
  font-weight: 600;
}

.stats-detail-sep {
  width: 1rpx;
  height: 36rpx;
  background: #E0EFF5;
  margin: 0 16rpx;
  flex-shrink: 0;
}

.stats-detail-sep-big {
  margin: 0 24rpx;
  height: 44rpx;
}

/* ─── 分享卡片 Canvas ──────────────────────────────────────────── */
.share-card-canvas {
  position: fixed;
  left: -9999rpx;
  top: 0;
  width: 320px;
  height: 520px;
  z-index: -1;
}

/* ─── 详情弹窗：快速编辑备注 ─────────────────────────────── */
.detail-note-row {
  cursor: pointer;
  flex-direction: column;
  align-items: flex-start;
  gap: 0;
}

.detail-note-row .detail-info-label {
  margin-bottom: 0;
}

/* 普通显示态：label + 内容在同一行 */
.detail-note-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.detail-note-display {
  flex: 1;
  text-align: right;
}

.detail-note-placeholder {
  font-size: 26rpx;
  color: #B8D0DC;
  font-style: italic;
}

/* 编辑态：input + 操作按钮占满右侧 */
.detail-note-edit-wrap {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-left: 20rpx;
}

.detail-note-input {
  background: #EDF6FA;
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
  color: #3D5A6E;
  min-height: 72rpx;
  width: 100%;
  box-sizing: border-box;
  border: 2rpx solid #A8D8EA;
}

.detail-note-input-placeholder {
  color: #C0D8E4;
}

.detail-note-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
}

.detail-note-cancel-btn,
.detail-note-save-btn {
  padding: 12rpx 28rpx;
  border-radius: 100rpx;
}

.detail-note-cancel-btn {
  background: #F0F6F9;
}

.detail-note-save-btn {
  background: linear-gradient(135deg, #4FB8D4, #3AA0BC);
}

.detail-note-btn-text {
  font-size: 26rpx;
  font-weight: 600;
}

.detail-note-btn-text.cancel {
  color: #7A9BAE;
}

.detail-note-btn-text.save {
  color: #FFFFFF;
}
