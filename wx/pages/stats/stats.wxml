<!-- pages/stats/stats.wxml - 统计页 -->
<view class="container">

  <!-- 顶部：视图模式切换（饼图 / 趋势 / 年度 / 环比 / 预算） -->
  <view class="view-mode-switcher">
    <view
      class="view-mode-btn {{viewMode === 'pie' ? 'view-mode-active' : ''}}"
      data-mode="pie"
      bindtap="switchViewMode"
    >📊 分类</view>
    <view
      class="view-mode-btn {{viewMode === 'trend' ? 'view-mode-active' : ''}}"
      data-mode="trend"
      bindtap="switchViewMode"
    >📈 趋势</view>
    <view
      class="view-mode-btn {{viewMode === 'annual' ? 'view-mode-active' : ''}}"
      data-mode="annual"
      bindtap="switchViewMode"
    >🗓️ 年度</view>
    <view
      class="view-mode-btn {{viewMode === 'compare' ? 'view-mode-active' : ''}}"
      data-mode="compare"
      bindtap="switchViewMode"
    >🔄 环比</view>
    <view
      class="view-mode-btn {{viewMode === 'budget' ? 'view-mode-active' : ''}}"
      data-mode="budget"
      bindtap="switchViewMode"
    >🎯 预算</view>
    <view
      class="view-mode-btn {{viewMode === 'ranking' ? 'view-mode-active' : ''}}"
      data-mode="ranking"
      bindtap="switchViewMode"
    >🏆 排行</view>
  </view>

  <!-- ═══════ 饼图模式 ═══════ -->
  <block wx:if="{{viewMode === 'pie'}}">

    <!-- 月份切换栏 -->
    <view class="month-nav">
      <view class="month-arrow" bindtap="prevMonth">
        <text class="arrow-text">‹</text>
      </view>
      <text class="month-title">{{currentMonth}} 统计</text>
      <view class="month-arrow {{isCurrentMonth ? 'arrow-disabled' : ''}}" bindtap="nextMonth">
        <text class="arrow-text">›</text>
      </view>
    </view>

    <!-- 收支切换 -->
    <view class="type-switcher">
      <view
        class="type-btn {{statsType === 'expense' ? 'active-expense' : ''}}"
        data-type="expense"
        bindtap="switchStatsType"
      >💸 支出</view>
      <view
        class="type-btn {{statsType === 'income' ? 'active-income' : ''}}"
        data-type="income"
        bindtap="switchStatsType"
      >💰 收入</view>
    </view>

    <!-- 本月收支概览 -->
    <view class="summary-row">
      <view class="summary-item">
        <text class="summary-label">本月支出</text>
        <text class="summary-amount expense-text">¥{{monthExpense}}</text>
      </view>
      <view class="summary-divider"></view>
      <view class="summary-item">
        <text class="summary-label">本月收入</text>
        <text class="summary-amount income-text">¥{{monthIncome}}</text>
      </view>
    </view>

    <!-- 智能分析卡片（有支出数据时展示） -->
    <view wx:if="{{insightCard && statsType === 'expense'}}" class="card insight-card">
      <view class="insight-header">
        <text class="insight-title">📉 消费分析</text>
        <text class="insight-days">已记 {{insightCard.daysPassed}} 天</text>
      </view>
      <view class="insight-stats-row">
        <view class="insight-stat-item">
          <text class="insight-stat-label">日均消费</text>
          <text class="insight-stat-val expense-text">¥{{insightCard.dailyAvg}}</text>
        </view>
        <view class="insight-stat-divider"></view>
        <view class="insight-stat-item" wx:if="{{insightCard.showPrediction}}">
          <text class="insight-stat-label">月末预测</text>
          <text class="insight-stat-val">¥{{insightCard.predicted}}</text>
        </view>
        <view class="insight-stat-item" wx:elif="{{!insightCard.showPrediction}}">
          <text class="insight-stat-label">月度实际</text>
          <text class="insight-stat-val expense-text">¥{{insightCard.predicted}}</text>
        </view>
        <view class="insight-stat-divider" wx:if="{{insightCard.vsLastMonthPct !== null}}"></view>
        <view class="insight-stat-item" wx:if="{{insightCard.vsLastMonthPct !== null}}">
          <text class="insight-stat-label">较上月同期</text>
          <view class="insight-vs-row">
            <text class="insight-vs-arrow {{insightCard.isUp ? 'vs-up' : 'vs-down'}}">{{insightCard.isUp ? '▲' : '▼'}}</text>
            <text class="insight-vs-pct {{insightCard.isUp ? 'expense-text' : 'income-text'}}">{{insightCard.vsLastMonthPct}}%</text>
          </view>
        </view>
      </view>
      <view class="insight-tip-row">
        <text class="insight-tip-emoji">{{insightCard.tipEmoji}}</text>
        <text class="insight-tip-text">{{insightCard.tip}}</text>
      </view>
    </view>

    <!-- 空状态 -->
    <view wx:if="{{isEmpty}}" class="empty-state">
      <text class="empty-emoji">🌸</text>
      <text class="empty-text">{{currentMonth}}暂无{{statsType === 'expense' ? '支出' : '收入'}}记录</text>
    </view>

    <!-- 图表区域 -->
    <view wx:else>

      <!-- Canvas 饼图（新版 2d context） -->
      <view class="chart-card">
        <canvas
          id="pieCanvas"
          type="2d"
          class="pie-canvas"
          style="width: 300px; height: 300px;"
        ></canvas>
        <!-- 降级旧 canvas -->
        <canvas
          canvas-id="pieCanvasLegacy"
          class="pie-canvas-legacy"
          style="width: 300px; height: 300px; display: none;"
        ></canvas>
      </view>

      <!-- 分类列表 -->
      <view class="card category-list">
        <view class="list-title-row">
          <text class="list-title">分类明细</text>
          <text class="list-title-hint">点击分类查看明细 →</text>
        </view>
        <view
          class="category-row category-row-tap"
          wx:for="{{categoryList}}"
          wx:key="category"
          data-category="{{item.category}}"
          bindtap="onCategoryTap"
          hover-class="category-row-hover"
          hover-stay-time="150"
        >
          <view class="cat-color-dot" style="background: {{item.color}};"></view>
          <view class="cat-info">
            <text class="cat-name">{{item.emoji}} {{item.category}}</text>
            <view class="progress-bar-wrap">
              <view class="progress-bar" style="width: {{item.percent}}%; background: {{item.color}};"></view>
            </view>
          </view>
          <view class="cat-right">
            <text class="cat-amount">¥{{item.amount}}</text>
            <text class="cat-percent">{{item.percent}}%</text>
          </view>
          <text class="cat-chevron">›</text>
        </view>
      </view>

    </view>

  </block>

  <!-- ═══════ 趋势模式 ═══════ -->
  <block wx:elif="{{viewMode === 'trend'}}">

    <!-- 趋势标题 -->
    <view class="trend-header">
      <text class="trend-title">近 6 个月收支趋势</text>
      <text class="trend-subtitle">粉色柱 = 支出，蓝色柱 = 收入</text>
    </view>

    <!-- 趋势柱状图 Canvas -->
    <view class="chart-card trend-chart-card">
      <canvas
        id="trendCanvas"
        type="2d"
        class="trend-canvas"
        style="width: 340px; height: 220px;"
      ></canvas>
      <!-- 降级旧 canvas -->
      <canvas
        canvas-id="trendCanvasLegacy"
        class="trend-canvas-legacy"
        style="width: 340px; height: 220px; display: none;"
      ></canvas>
    </view>

    <!-- 月度明细列表 -->
    <view class="card trend-detail-list">
      <text class="list-title">月度明细</text>
      <view
        class="trend-detail-row"
        wx:for="{{trendData}}"
        wx:key="ym"
      >
        <text class="trend-detail-month">{{item.label}}</text>
        <view class="trend-detail-amounts">
          <view class="trend-amount-item">
            <text class="trend-amount-label expense-label">支出</text>
            <text class="trend-amount-val expense-text">¥{{item.expense}}</text>
          </view>
          <view class="trend-amount-item">
            <text class="trend-amount-label income-label">收入</text>
            <text class="trend-amount-val income-text">¥{{item.income}}</text>
          </view>
          <view class="trend-amount-item">
            <text class="trend-amount-label">结余</text>
            <text class="trend-amount-val {{item.net >= 0 ? 'income-text' : 'expense-text'}}">{{item.net >= 0 ? '+' : ''}}{{item.net}}</text>
          </view>
        </view>
      </view>
    </view>

  </block>

  <!-- ═══════ 年度总览模式 ═══════ -->
  <block wx:elif="{{viewMode === 'annual'}}">

    <!-- 年份切换栏 -->
    <view class="month-nav">
      <view class="month-arrow" bindtap="prevYear">
        <text class="arrow-text">‹</text>
      </view>
      <text class="month-title">{{annualYear}} 年度总览</text>
      <view class="month-arrow {{annualYear >= currentYear ? 'arrow-disabled' : ''}}" bindtap="nextYear">
        <text class="arrow-text">›</text>
      </view>
    </view>

    <!-- 年度汇总卡片 -->
    <view wx:if="{{annualSummary}}" class="annual-summary-card">
      <view class="annual-summary-row">
        <view class="annual-stat-item">
          <text class="annual-stat-label">年度总收入</text>
          <text class="annual-stat-val income-text">¥{{annualSummary.totalIncome}}</text>
        </view>
        <view class="annual-stat-divider"></view>
        <view class="annual-stat-item">
          <text class="annual-stat-label">年度总支出</text>
          <text class="annual-stat-val expense-text">¥{{annualSummary.totalExpense}}</text>
        </view>
      </view>
      <view class="annual-net-row">
        <text class="annual-net-label">年度净结余</text>
        <text class="annual-net-val {{annualSummary.isPositive ? 'income-text' : 'expense-text'}}">
          {{annualSummary.isPositive ? '+' : ''}}¥{{annualSummary.netSaving}}
        </text>
      </view>

      <!-- 储蓄率 + 月均 -->
      <view class="annual-extra-row">
        <view class="annual-extra-item">
          <text class="annual-extra-emoji">💰</text>
          <text class="annual-extra-label">储蓄率</text>
          <text class="annual-extra-val {{annualSummary.savingRatePositive ? 'income-text' : 'expense-text'}}">{{annualSummary.savingRateLabel}}</text>
        </view>
        <view class="annual-extra-divider"></view>
        <view class="annual-extra-item">
          <text class="annual-extra-emoji">📅</text>
          <text class="annual-extra-label">月均支出</text>
          <text class="annual-extra-val expense-text">¥{{annualSummary.avgMonthExpense}}</text>
        </view>
        <view class="annual-extra-divider"></view>
        <view class="annual-extra-item">
          <text class="annual-extra-emoji">📅</text>
          <text class="annual-extra-label">月均收入</text>
          <text class="annual-extra-val income-text">¥{{annualSummary.avgMonthIncome}}</text>
        </view>
      </view>

      <view class="annual-highlight-row">
        <view class="annual-highlight-item">
          <text class="annual-highlight-emoji">📌</text>
          <text class="annual-highlight-label">支出最多</text>
          <text class="annual-highlight-month expense-text">{{annualSummary.bestExpenseMonth}}</text>
        </view>
        <view class="annual-highlight-item">
          <text class="annual-highlight-emoji">🌟</text>
          <text class="annual-highlight-label">收入最多</text>
          <text class="annual-highlight-month income-text">{{annualSummary.bestIncomeMonth}}</text>
        </view>
        <view class="annual-highlight-item">
          <text class="annual-highlight-emoji">🌿</text>
          <text class="annual-highlight-label">支出最少</text>
          <text class="annual-highlight-month income-text">{{annualSummary.bestSaveMonth}}</text>
        </view>
      </view>

      <!-- 复制年度报告按钮 -->
      <view class="annual-copy-btn" bindtap="onCopyAnnualReport">
        <text class="annual-copy-icon">📋</text>
        <text class="annual-copy-text">复制年度报告</text>
      </view>
    </view>

    <!-- 全年柱状图 -->
    <view class="chart-card annual-chart-card">
      <canvas
        id="annualCanvas"
        type="2d"
        class="annual-canvas"
        style="width: 340px; height: 200px;"
      ></canvas>
      <canvas
        canvas-id="annualCanvasLegacy"
        class="annual-canvas-legacy"
        style="width: 340px; height: 200px; display: none;"
      ></canvas>
    </view>

    <!-- 全年月度明细 -->
    <view class="card trend-detail-list annual-detail-list">
      <text class="list-title">全年月度明细</text>
      <view
        class="trend-detail-row"
        wx:for="{{annualData}}"
        wx:key="ym"
      >
        <text class="trend-detail-month annual-month-label">{{item.label}}</text>
        <view class="trend-detail-amounts">
          <view class="trend-amount-item">
            <text class="trend-amount-label expense-label">支出</text>
            <text class="trend-amount-val {{item.expense > 0 ? 'expense-text' : 'zero-text'}}">
              {{item.expense > 0 ? '¥' : ''}}{{item.expense > 0 ? item.expense : '—'}}
            </text>
          </view>
          <view class="trend-amount-item">
            <text class="trend-amount-label income-label">收入</text>
            <text class="trend-amount-val {{item.income > 0 ? 'income-text' : 'zero-text'}}">
              {{item.income > 0 ? '¥' : ''}}{{item.income > 0 ? item.income : '—'}}
            </text>
          </view>
          <view class="trend-amount-item">
            <text class="trend-amount-label">结余</text>
            <text class="trend-amount-val {{(item.expense === 0 && item.income === 0) ? 'zero-text' : (item.net >= 0 ? 'income-text' : 'expense-text')}}">
              {{(item.expense === 0 && item.income === 0) ? '—' : (item.net >= 0 ? '+' : '')}}{{(item.expense === 0 && item.income === 0) ? '' : item.net}}
            </text>
          </view>
        </view>
      </view>
    </view>

  </block>

  <!-- ═══════ 环比对比模式 ═══════ -->
  <block wx:if="{{viewMode === 'compare'}}">

    <!-- 月份切换栏 -->
    <view class="month-nav">
      <view class="month-arrow" bindtap="prevMonth">
        <text class="arrow-text">‹</text>
      </view>
      <text class="month-title">{{currentMonth}} 环比</text>
      <view class="month-arrow {{isCurrentMonth ? 'arrow-disabled' : ''}}" bindtap="nextMonth">
        <text class="arrow-text">›</text>
      </view>
    </view>

    <!-- 收入 / 支出切换 tab -->
    <view class="compare-type-tabs">
      <view
        class="compare-type-tab {{compareType === 'expense' ? 'compare-type-active compare-type-expense' : ''}}"
        data-type="expense"
        bindtap="switchCompareType"
      >
        <text class="compare-type-tab-text">💸 支出</text>
      </view>
      <view
        class="compare-type-tab {{compareType === 'income' ? 'compare-type-active compare-type-income' : ''}}"
        data-type="income"
        bindtap="switchCompareType"
      >
        <text class="compare-type-tab-text">💰 收入</text>
      </view>
    </view>

    <!-- 总计对比概览 -->
    <view class="compare-overview card" wx:if="{{compareData}}">
      <view class="compare-overview-row">
        <view class="compare-ov-item">
          <text class="compare-ov-label">本月{{compareType === 'income' ? '收入' : '支出'}}</text>
          <text class="compare-ov-val {{compareType === 'income' ? 'income-text' : 'expense-text'}}">¥{{compareData.curVal}}</text>
        </view>
        <view class="compare-ov-arrow">
          <text class="compare-ov-vs-text {{
            compareType === 'income'
              ? (compareData.diff > 0 ? 'vs-down-text' : compareData.diff < 0 ? 'vs-up-text' : '')
              : (compareData.diff > 0 ? 'vs-up-text' : compareData.diff < 0 ? 'vs-down-text' : '')
          }}">
            {{compareData.diff > 0 ? '▲' : compareData.diff < 0 ? '▼' : '='}}
            {{compareData.diffAbs > 0 ? '¥' + compareData.diffAbs : '持平'}}
          </text>
          <text class="compare-ov-vs-label">较上月</text>
        </view>
        <view class="compare-ov-item">
          <text class="compare-ov-label">上月{{compareType === 'income' ? '收入' : '支出'}}</text>
          <text class="compare-ov-val compare-prev-text">¥{{compareData.prevVal}}</text>
        </view>
      </view>
    </view>

    <!-- 空状态 -->
    <view wx:if="{{!compareData || compareData.items.length === 0}}" class="empty-state">
      <text class="empty-icon">🌸</text>
      <text class="empty-text">暂无数据，快去记账吧～</text>
    </view>

    <!-- 分类环比列表 -->
    <view wx:if="{{compareData && compareData.items.length > 0}}" class="card compare-list-card">
      <view class="list-title-row">
        <text class="list-title">{{compareType === 'income' ? '收入' : '支出'}}分类环比</text>
        <text class="list-title-hint">点击查看明细 →</text>
      </view>
      <view class="compare-legend-row">
        <view class="compare-legend-item">
          <view class="compare-legend-dot {{compareType === 'income' ? 'compare-cur-dot-income' : 'compare-cur-dot'}}"></view>
          <text class="compare-legend-label">本月</text>
        </view>
        <view class="compare-legend-item">
          <view class="compare-legend-dot compare-prev-dot"></view>
          <text class="compare-legend-label">上月</text>
        </view>
      </view>
      <view
        class="compare-row"
        wx:for="{{compareData.items}}"
        wx:key="category"
        data-category="{{item.category}}"
        bindtap="onCompareCategoryTap"
        hover-class="category-row-hover"
        hover-stay-time="150"
      >
        <view class="compare-row-header">
          <view class="compare-cat-label">
            <text class="compare-cat-emoji">{{item.emoji}}</text>
            <text class="compare-cat-name">{{item.category}}</text>
          </view>
          <view class="compare-diff-badge {{
            compareType === 'income'
              ? (item.diff > 0 ? 'badge-down' : item.diff < 0 ? 'badge-up' : 'badge-even')
              : (item.diff > 0 ? 'badge-up' : item.diff < 0 ? 'badge-down' : 'badge-even')
          }}">
            <text class="compare-diff-text">
              {{item.diff > 0 ? '▲' : item.diff < 0 ? '▼' : '—'}}
              {{item.diffPct > 0 ? item.diffPct + '%' : ''}}
            </text>
          </view>
        </view>
        <!-- 本月 bar -->
        <view class="compare-bar-row">
          <text class="compare-bar-amount compare-cur-amount {{compareType === 'income' ? 'income-text' : 'expense-text'}}">¥{{item.curAmount}}</text>
          <view class="compare-bar-track">
            <view
              class="compare-bar-fill {{compareType === 'income' ? 'compare-bar-cur-income' : 'compare-bar-cur'}}"
              style="width: {{item.curPct}}%"
            ></view>
          </view>
        </view>
        <!-- 上月 bar -->
        <view class="compare-bar-row">
          <text class="compare-bar-amount compare-prev-amount compare-prev-text">¥{{item.prevAmount}}</text>
          <view class="compare-bar-track">
            <view
              class="compare-bar-fill compare-bar-prev"
              style="width: {{item.prevPct}}%"
            ></view>
          </view>
        </view>
      </view>
    </view>

    <!-- 提示文案 -->
    <view wx:if="{{compareData && compareData.items.length > 0}}" class="compare-tip-row">
      <text class="compare-tip-emoji">{{compareData.tipEmoji}}</text>
      <text class="compare-tip-text">{{compareData.tip}}</text>
    </view>

  </block>

  <!-- ═══════ 分类预算模式 ═══════ -->
  <block wx:if="{{viewMode === 'budget'}}">

    <!-- 月份切换栏 -->
    <view class="month-nav">
      <view class="month-arrow" bindtap="prevMonth">
        <text class="arrow-text">‹</text>
      </view>
      <text class="month-title">{{currentMonth}} 分类预算</text>
      <view class="month-arrow {{isCurrentMonth ? 'arrow-disabled' : ''}}" bindtap="nextMonth">
        <text class="arrow-text">›</text>
      </view>
    </view>

    <!-- 提示文案 -->
    <view class="compare-tip-row" wx:if="{{catBudgetTip}}">
      <text class="compare-tip-emoji">{{catBudgetTipEmoji}}</text>
      <text class="compare-tip-text">{{catBudgetTip}}</text>
    </view>

    <!-- 空状态 -->
    <view wx:if="{{catBudgetItems.length === 0}}" class="empty-state">
      <text class="empty-icon">🌸</text>
      <text class="empty-text">本月还没有支出记录～</text>
    </view>

    <!-- 分类预算列表 -->
    <view wx:else class="card cat-budget-card">
      <view class="list-title-row">
        <text class="list-title">支出分类限额</text>
        <text class="list-title-hint">点击「设预算」设置限额</text>
      </view>

      <view
        class="cat-budget-row"
        wx:for="{{catBudgetItems}}"
        wx:key="category"
      >
        <!-- 分类名 + 超预算标志 -->
        <view class="cat-budget-header">
          <view class="cat-budget-label">
            <text class="cat-budget-emoji">{{item.emoji}}</text>
            <text class="cat-budget-name">{{item.category}}</text>
            <view wx:if="{{item.isOver}}" class="cat-budget-over-badge">超预算</view>
          </view>
          <view
            class="cat-budget-set-btn"
            data-category="{{item.category}}"
            bindtap="onSetCatBudget"
          >
            <text class="cat-budget-set-text">{{item.hasBudget ? '修改' : '设预算'}}</text>
          </view>
        </view>

        <!-- 金额行 -->
        <view class="cat-budget-amounts">
          <text class="cat-budget-spent expense-text">¥{{item.spent}}</text>
          <text wx:if="{{item.hasBudget}}" class="cat-budget-slash"> / </text>
          <text wx:if="{{item.hasBudget}}" class="cat-budget-limit">¥{{item.budget}}</text>
          <view wx:if="{{item.hasBudget}}" class="cat-budget-remain-wrap">
            <text wx:if="{{!item.isOver}}" class="cat-budget-remain-ok">还剩 ¥{{item.remain}}</text>
            <text wx:else class="cat-budget-remain-over">超出 ¥{{item.remain}}</text>
          </view>
        </view>

        <!-- 进度条 -->
        <view wx:if="{{item.hasBudget}}" class="cat-budget-bar-bg">
          <view
            class="cat-budget-bar-fill {{item.isOver ? 'cat-budget-bar-over' : item.percent >= 80 ? 'cat-budget-bar-warn' : 'cat-budget-bar-ok'}}"
            style="width: {{item.percent}}%;"
          ></view>
        </view>
        <view wx:if="{{item.hasBudget}}" class="cat-budget-percent-row">
          <text class="cat-budget-percent-text {{item.isOver ? 'budget-over-text' : item.percent >= 80 ? 'budget-warn-text' : ''}}">已用 {{item.percent}}%</text>
        </view>

      </view>
    </view>

  </block>

  <!-- ═══════ 排行榜模式 ═══════ -->
  <block wx:if="{{viewMode === 'ranking'}}">

    <!-- 类型切换：支出 / 收入 -->
    <view class="type-switcher ranking-type-switcher">
      <view
        class="type-btn {{rankingType === 'expense' ? 'active-expense' : ''}}"
        data-type="expense"
        bindtap="switchRankingType"
      >💸 支出排行</view>
      <view
        class="type-btn {{rankingType === 'income' ? 'active-income' : ''}}"
        data-type="income"
        bindtap="switchRankingType"
      >💰 收入排行</view>
    </view>

    <!-- 时间范围选择 -->
    <view class="ranking-range-row">
      <view
        class="ranking-range-chip {{rankingRange === '本月' ? 'range-chip-active' : ''}}"
        data-range="本月"
        bindtap="switchRankingRange"
      >本月</view>
      <view
        class="ranking-range-chip {{rankingRange === '3' ? 'range-chip-active' : ''}}"
        data-range="3"
        bindtap="switchRankingRange"
      >迓 3 月</view>
      <view
        class="ranking-range-chip {{rankingRange === '6' ? 'range-chip-active' : ''}}"
        data-range="6"
        bindtap="switchRankingRange"
      >迓 6 月</view>
      <view
        class="ranking-range-chip {{rankingRange === '年' ? 'range-chip-active' : ''}}"
        data-range="年"
        bindtap="switchRankingRange"
      >今年</view>
    </view>

    <!-- 概要信息条 -->
    <view wx:if="{{!rankingIsEmpty}}" class="ranking-summary-bar">
      <view class="ranking-summary-item">
        <text class="ranking-summary-label">{{rankingType === 'expense' ? '总支出' : '总收入'}}</text>
        <text class="ranking-summary-value {{rankingType === 'expense' ? 'expense-text' : 'income-text'}}">¥{{rankingTotal}}</text>
      </view>
      <view class="ranking-summary-divider"></view>
      <view class="ranking-summary-item">
        <text class="ranking-summary-label">时间范围</text>
        <text class="ranking-summary-value">{{rankingMonths}} 个月</text>
      </view>
      <view class="ranking-summary-divider"></view>
      <view class="ranking-summary-item">
        <text class="ranking-summary-label">日均</text>
        <text class="ranking-summary-value">¥{{rankingDailyAvg}}</text>
      </view>
    </view>

    <!-- 空状态 -->
    <view wx:if="{{rankingIsEmpty}}" class="empty-wrap">
      <text class="empty-icon">🌸</text>
      <text class="empty-text">所选时间范围内还没有记录～</text>
    </view>

    <!-- 排行榜列表 -->
    <view wx:else class="card ranking-card">
      <view class="ranking-title-row">
        <text class="ranking-title">{{rankingType === 'expense' ? '💸 支出分类排行' : '💰 收入来源排行'}}</text>
        <text class="ranking-title-hint">共 {{rankingItems.length}} 个分类</text>
      </view>

      <view
        class="ranking-row"
        wx:for="{{rankingItems}}"
        wx:key="category"
      >
        <!-- 排名 – Top3 特殊样式 -->
        <view class="ranking-rank {{index === 0 ? 'rank-1' : index === 1 ? 'rank-2' : index === 2 ? 'rank-3' : ''}}">
          <text class="ranking-rank-text">{{index === 0 ? '🥇' : index === 1 ? '🥈' : index === 2 ? '🥉' : index + 1}}</text>
        </view>

        <!-- 分类信息 + 进度条 -->
        <view class="ranking-body">
          <view class="ranking-info-row">
            <view class="ranking-cat-label">
              <text class="ranking-emoji">{{item.emoji}}</text>
              <text class="ranking-cat-name">{{item.category}}</text>
            </view>
            <view class="ranking-amounts">
              <text class="ranking-amount {{rankingType === 'expense' ? 'expense-text' : 'income-text'}}">¥{{item.amount}}</text>
              <text class="ranking-percent">{{item.percent}}%</text>
            </view>
          </view>

          <!-- 水平进度条 -->
          <view class="ranking-bar-bg">
            <view
              class="ranking-bar-fill {{rankingType === 'expense' ? 'ranking-bar-expense' : 'ranking-bar-income'}} {{index === 0 ? 'ranking-bar-top' : ''}}"
              style="width: {{item.barWidth}}%;"
            ></view>
          </view>

          <!-- 次要信息：笔数 + 均均 -->
          <view class="ranking-sub-row">
            <text class="ranking-sub-text">记录 {{item.count}} 笔</text>
            <text class="ranking-sub-text">均均 ¥{{item.avgAmount}}</text>
          </view>
        </view>
      </view>
    </view>

  </block>

</view>
