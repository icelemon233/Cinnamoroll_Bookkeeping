/* pages/stats/stats.wxss */

/* 月份切换导航栏 */
.month-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 0 24rpx;
}

.month-arrow {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #EBF7FB;
}

.arrow-text {
  font-size: 48rpx;
  color: #4FB8D4;
  font-weight: 700;
  line-height: 1;
  margin-top: -4rpx; /* 视觉居中微调 */
}

.arrow-disabled {
  opacity: 0.3;
}

.month-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #3D5A6E;
}

/* 收支概览卡片 */
.summary-row {
  display: flex;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 28rpx 0;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(79, 184, 212, 0.1);
}

.summary-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.summary-divider {
  width: 1rpx;
  background: #EBF7FB;
  margin: 8rpx 0;
}

.summary-label {
  font-size: 24rpx;
  color: #9BAAB8;
  margin-bottom: 8rpx;
}

.summary-amount {
  font-size: 36rpx;
  font-weight: 700;
}

.income-text {
  color: #4FB8D4;
}

.expense-text {
  color: #FF8BAB;
}

/* 收支切换 */
.type-switcher {
  display: flex;
  background: #FFFFFF;
  border-radius: 100rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(79, 184, 212, 0.1);
}

.type-btn {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 100rpx;
  font-size: 30rpx;
  color: #9BAAB8;
  transition: all 0.2s;
}

.active-expense {
  background: #FFE0E8;
  color: #FF8BAB;
  font-weight: 600;
}

.active-income {
  background: #E0F5FA;
  color: #4FB8D4;
  font-weight: 600;
}

/* 饼图卡片 */
.chart-card {
  background: #FFFFFF;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(79, 184, 212, 0.12);
}

.pie-canvas {
  border-radius: 50%;
}

.pie-canvas-legacy {
  border-radius: 50%;
}

/* 分类明细列表 */
.category-list {
  padding: 28rpx;
}

.list-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #3D5A6E;
  display: block;
  margin-bottom: 24rpx;
}

.category-row {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #F0F8FF;
}

.category-row:last-child {
  border-bottom: none;
}

.cat-color-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  flex-shrink: 0;
  margin-right: 16rpx;
}

.cat-info {
  flex: 1;
  margin-right: 20rpx;
}

.cat-name {
  font-size: 28rpx;
  color: #3D5A6E;
  display: block;
  margin-bottom: 8rpx;
}

.progress-bar-wrap {
  height: 8rpx;
  background: #F0F8FF;
  border-radius: 100rpx;
  overflow: hidden;
}

.progress-bar {
  height: 100%;
  border-radius: 100rpx;
  transition: width 0.5s ease;
}

.cat-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  flex-shrink: 0;
}

.cat-amount {
  font-size: 30rpx;
  font-weight: 700;
  color: #3D5A6E;
}

.cat-percent {
  font-size: 22rpx;
  color: #9BAAB8;
  margin-top: 4rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}

.empty-emoji {
  font-size: 100rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #9BAAB8;
}

/* ─── 视图模式切换（分类 / 趋势） ─────────────────────── */

.view-mode-switcher {
  display: flex;
  background: #FFFFFF;
  border-radius: 100rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(79, 184, 212, 0.1);
}

.view-mode-btn {
  flex: 1;
  text-align: center;
  padding: 16rpx 4rpx;
  border-radius: 100rpx;
  font-size: 24rpx;
  color: #9BAAB8;
  transition: all 0.2s;
  white-space: nowrap;
  overflow: hidden;
}

.view-mode-active {
  background: #E0F5FA;
  color: #4FB8D4;
  font-weight: 600;
}

/* ─── 趋势柱状图 ──────────────────────────────────────── */

.trend-header {
  padding: 4rpx 4rpx 20rpx;
}

.trend-title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #3D5A6E;
  margin-bottom: 8rpx;
}

.trend-subtitle {
  font-size: 24rpx;
  color: #9BAAB8;
}

.trend-chart-card {
  padding: 28rpx 16rpx;
}

.trend-canvas {
  display: block;
}

.trend-canvas-legacy {
  display: block;
}

/* ─── 趋势月度明细列表 ─────────────────────────────────── */

.trend-detail-list {
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.trend-detail-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F0F8FF;
}

.trend-detail-row:last-child {
  border-bottom: none;
}

.trend-detail-month {
  font-size: 32rpx;
  font-weight: 700;
  color: #3D5A6E;
  width: 72rpx;
  flex-shrink: 0;
}

.trend-detail-amounts {
  flex: 1;
  display: flex;
  justify-content: space-around;
}

.trend-amount-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.trend-amount-label {
  font-size: 22rpx;
  color: #9BAAB8;
  margin-bottom: 6rpx;
}

.expense-label {
  color: #FFB3C4;
}

.income-label {
  color: #88C8D8;
}

.trend-amount-val {
  font-size: 28rpx;
  font-weight: 600;
}

/* ─── 年度总览 ──────────────────────────────────────── */

.annual-summary-card {
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 32rpx 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(79, 184, 212, 0.12);
}

.annual-summary-row {
  display: flex;
  align-items: center;
  margin-bottom: 28rpx;
}

.annual-stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.annual-stat-divider {
  width: 1rpx;
  height: 64rpx;
  background: #EBF7FB;
  margin: 0 16rpx;
}

.annual-stat-label {
  font-size: 24rpx;
  color: #9BAAB8;
  margin-bottom: 8rpx;
}

.annual-stat-val {
  font-size: 36rpx;
  font-weight: 700;
}

.annual-net-row {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 0;
  background: #F7FCFE;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  gap: 16rpx;
}

.annual-net-label {
  font-size: 28rpx;
  color: #7A9AAB;
}

.annual-net-val {
  font-size: 38rpx;
  font-weight: 800;
}

/* 储蓄率 + 月均 */
.annual-extra-row {
  display: flex;
  justify-content: space-around;
  align-items: center;
  background: rgba(79, 184, 212, 0.06);
  border-radius: 16rpx;
  padding: 20rpx 12rpx;
  margin-bottom: 20rpx;
}

.annual-extra-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  flex: 1;
}

.annual-extra-emoji {
  font-size: 32rpx;
}

.annual-extra-label {
  font-size: 20rpx;
  color: #9BAAB8;
}

.annual-extra-val {
  font-size: 28rpx;
  font-weight: 700;
}

.annual-extra-divider {
  width: 1rpx;
  height: 60rpx;
  background: #E0EFF5;
}

/* 复制年度报告按钮 */
.annual-copy-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  margin-top: 24rpx;
  padding: 18rpx 0;
  background: linear-gradient(135deg, #E8F6FA, #F0F8FF);
  border: 1rpx solid #C8E8F2;
  border-radius: 20rpx;
  active-opacity: 0.7;
}

.annual-copy-btn:active {
  opacity: 0.7;
}

.annual-copy-icon {
  font-size: 32rpx;
}

.annual-copy-text {
  font-size: 28rpx;
  color: #4FB8D4;
  font-weight: 600;
}

.annual-highlight-row {
  display: flex;
  justify-content: space-around;
  padding-top: 8rpx;
}

.annual-highlight-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.annual-highlight-emoji {
  font-size: 36rpx;
}

.annual-highlight-label {
  font-size: 22rpx;
  color: #9BAAB8;
}

.annual-highlight-month {
  font-size: 32rpx;
  font-weight: 700;
}

.annual-chart-card {
  padding: 24rpx 12rpx;
  margin-bottom: 24rpx;
}

.annual-canvas {
  display: block;
}

.annual-canvas-legacy {
  display: block;
}

.annual-detail-list {
  margin-bottom: 40rpx;
}

.annual-month-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #3D5A6E;
  width: 64rpx;
}

.zero-text {
  color: #C8DAE0;
}

/* ─── 智能分析卡片 ──────────────────────────────── */
.insight-card {
  margin-bottom: 24rpx;
  padding: 28rpx 28rpx 20rpx;
}

.insight-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.insight-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #3D5A6E;
}

.insight-days {
  font-size: 22rpx;
  color: #9BAAB8;
  background: #EBF7FB;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
}

.insight-stats-row {
  display: flex;
  align-items: center;
  justify-content: space-around;
  margin-bottom: 20rpx;
}

.insight-stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  flex: 1;
}

.insight-stat-divider {
  width: 1rpx;
  height: 48rpx;
  background: #D8EEF5;
}

.insight-stat-label {
  font-size: 22rpx;
  color: #9BAAB8;
}

.insight-stat-val {
  font-size: 34rpx;
  font-weight: 700;
  color: #3D5A6E;
}

.insight-vs-row {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.insight-vs-arrow {
  font-size: 22rpx;
  font-weight: 700;
}

.vs-up {
  color: #FF6B8A;
}

.vs-down {
  color: #4FB8D4;
}

.insight-vs-pct {
  font-size: 32rpx;
  font-weight: 700;
}

.insight-tip-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  background: #F5FAFE;
  border-radius: 16rpx;
  padding: 14rpx 18rpx;
}

.insight-tip-emoji {
  font-size: 30rpx;
  flex-shrink: 0;
}

.insight-tip-text {
  font-size: 24rpx;
  color: #5A7A8E;
  line-height: 1.5;
}

/* ═══════ 环比对比模式 ═══════ */

/* 收入/支出切换 tab */
.compare-type-tabs {
  display: flex;
  background: #F0F8FF;
  border-radius: 24rpx;
  padding: 6rpx;
  margin-bottom: 20rpx;
  gap: 6rpx;
}

.compare-type-tab {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  border-radius: 20rpx;
  transition: background 0.2s;
}

.compare-type-tab-text {
  font-size: 26rpx;
  color: #9BAAB8;
}

.compare-type-active .compare-type-tab-text {
  font-weight: 600;
}

.compare-type-expense {
  background: #FFFFFF;
  box-shadow: 0 2rpx 8rpx rgba(255, 139, 171, 0.18);
}

.compare-type-expense .compare-type-tab-text {
  color: #FF8BAB;
}

.compare-type-income {
  background: #FFFFFF;
  box-shadow: 0 2rpx 8rpx rgba(79, 184, 212, 0.18);
}

.compare-type-income .compare-type-tab-text {
  color: #4FB8D4;
}

/* 顶部总计对比卡片 */
.compare-overview {
  padding: 28rpx 32rpx;
  margin-bottom: 20rpx;
}

.compare-overview-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.compare-ov-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.compare-ov-label {
  font-size: 24rpx;
  color: #9BAAB8;
  margin-bottom: 8rpx;
}

.compare-ov-val {
  font-size: 40rpx;
  font-weight: 700;
}

.compare-prev-text {
  color: #9BAAB8;
}

.compare-ov-arrow {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 16rpx;
}

.compare-ov-vs-text {
  font-size: 26rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.vs-up-text {
  color: #FF7096;
}

.vs-down-text {
  color: #4FB8D4;
}

.compare-ov-vs-label {
  font-size: 20rpx;
  color: #B0C4D0;
  margin-top: 4rpx;
}

/* 分类环比列表卡片 */
.compare-list-card {
  padding: 28rpx 32rpx;
  margin-bottom: 16rpx;
}

/* 图例行 */
.compare-legend-row {
  display: flex;
  gap: 24rpx;
  margin-bottom: 20rpx;
}

.compare-legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.compare-legend-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
}

.compare-cur-dot {
  background: #FF8BAB;
}

.compare-cur-dot-income {
  background: #4FB8D4;
}

.compare-prev-dot {
  background: #C8E6EF;
}

.compare-legend-label {
  font-size: 22rpx;
  color: #9BAAB8;
}

/* 单行分类对比 */
.compare-row {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F0F8FF;
}

.compare-row:last-child {
  border-bottom: none;
}

.compare-row-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.compare-cat-label {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.compare-cat-emoji {
  font-size: 30rpx;
}

.compare-cat-name {
  font-size: 28rpx;
  color: #3D5A6E;
  font-weight: 500;
}

/* 差异徽章 */
.compare-diff-badge {
  border-radius: 20rpx;
  padding: 4rpx 16rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.badge-up {
  background: #FFF0F4;
  color: #FF7096;
}

.badge-down {
  background: #E8F7FB;
  color: #4FB8D4;
}

.badge-even {
  background: #F5F5F5;
  color: #9BAAB8;
}

.compare-diff-text {
  font-size: 22rpx;
}

/* 条形图行 */
.compare-bar-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.compare-bar-row:last-child {
  margin-bottom: 0;
}

.compare-bar-amount {
  width: 120rpx;
  font-size: 24rpx;
  text-align: right;
  flex-shrink: 0;
}

.compare-cur-amount {
  color: #FF7096;
}

.compare-prev-amount {
  color: #9BAAB8;
}

.compare-bar-track {
  flex: 1;
  height: 16rpx;
  background: #F0F8FF;
  border-radius: 8rpx;
  overflow: hidden;
}

.compare-bar-fill {
  height: 100%;
  border-radius: 8rpx;
  min-width: 4rpx;
  transition: width 0.3s ease;
}

.compare-bar-cur {
  background: linear-gradient(90deg, #FF8BAB, #FFCCD8);
}

.compare-bar-cur-income {
  background: linear-gradient(90deg, #4FB8D4, #A8D8EA);
}

.compare-bar-prev {
  background: linear-gradient(90deg, #A8D8EA, #C8E6EF);
}

/* 底部提示文案 */
.compare-tip-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx 24rpx;
  background: #F7FCFE;
  border-radius: 20rpx;
  margin-bottom: 32rpx;
}

.compare-tip-emoji {
  font-size: 32rpx;
}

.compare-tip-text {
  font-size: 26rpx;
  color: #6A8EA0;
  line-height: 1.5;
  flex: 1;
}

/* ─── 分类列表标题行（含点击提示）────────────────────── */
.list-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.list-title-hint {
  font-size: 22rpx;
  color: #4FB8D4;
  opacity: 0.85;
}

/* 可点击的分类行 */
.category-row-tap {
  cursor: pointer;
  position: relative;
}

.category-row-hover {
  background: rgba(79, 184, 212, 0.07);
  border-radius: 12rpx;
}

/* 分类行右侧箭头 */
.cat-chevron {
  font-size: 32rpx;
  color: #B0D8E8;
  margin-left: 8rpx;
  font-weight: 600;
  flex-shrink: 0;
}

/* 环比行可点击样式复用 category-row-hover（已在 compare-row 上绑定） */

/* ═══════════════════════════════════════════════
   分类预算模式
   ═══════════════════════════════════════════════ */

.cat-budget-card {
  padding: 28rpx 24rpx;
}

.cat-budget-row {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #EBF7FB;
}

.cat-budget-row:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

/* 头部：分类名 + 操作按钮 */
.cat-budget-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.cat-budget-label {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex: 1;
}

.cat-budget-emoji {
  font-size: 32rpx;
}

.cat-budget-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #3D5A6E;
}

.cat-budget-over-badge {
  font-size: 20rpx;
  color: #FFFFFF;
  background: #FF8BAB;
  border-radius: 20rpx;
  padding: 2rpx 12rpx;
  margin-left: 8rpx;
  font-weight: 600;
}

.cat-budget-set-btn {
  padding: 6rpx 18rpx;
  border: 1.5rpx solid #4FB8D4;
  border-radius: 20rpx;
  flex-shrink: 0;
}

.cat-budget-set-text {
  font-size: 22rpx;
  color: #4FB8D4;
  font-weight: 500;
}

/* 金额行 */
.cat-budget-amounts {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
  margin-bottom: 10rpx;
}

.cat-budget-spent {
  font-size: 30rpx;
  font-weight: 700;
}

.cat-budget-slash {
  font-size: 24rpx;
  color: #B0C4D0;
}

.cat-budget-limit {
  font-size: 26rpx;
  color: #7A9AAB;
}

.cat-budget-remain-wrap {
  margin-left: auto;
}

.cat-budget-remain-ok {
  font-size: 22rpx;
  color: #7EC879;
}

.cat-budget-remain-over {
  font-size: 22rpx;
  color: #FF8BAB;
  font-weight: 600;
}

/* 进度条 */
.cat-budget-bar-bg {
  width: 100%;
  height: 10rpx;
  background: #EBF7FB;
  border-radius: 8rpx;
  overflow: hidden;
  margin-bottom: 6rpx;
}

.cat-budget-bar-fill {
  height: 100%;
  border-radius: 8rpx;
  transition: width 0.4s ease;
}

.cat-budget-bar-ok {
  background: linear-gradient(90deg, #4FB8D4, #7EC8E3);
}

.cat-budget-bar-warn {
  background: linear-gradient(90deg, #F5A623, #F7C86A);
}

.cat-budget-bar-over {
  background: linear-gradient(90deg, #FF6B8A, #FF8BAB);
}

